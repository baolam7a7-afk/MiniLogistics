@using MiniLogistics.Web.Models.Product
@using MiniLogistics.Web.Services.Voucher
@inject NavigationManager Navigation
@inject VoucherOfferService VoucherOffers

<article class="product-card store-product-card"
         @onclick="Open">
    <div class="product-image store-product-image">
        @if (!string.IsNullOrWhiteSpace(Product.ImageUrl) && !imageFailed)
        {
            <img src="@Product.ImageUrl"
                 alt="@Product.Name"
                 loading="lazy"
                 style="width:100%;height:100%;object-fit:cover"
                 @onerror="OnImageError" />
        }
        else
        {
            <div class="store-product-placeholder">
                <span>@Initial</span>
            </div>
        }
    </div>

    <div class="product-card-body">
        <div class="product-card-tags">
            @if (!string.IsNullOrWhiteSpace(Product.CategoryName))
            {
                <span class="product-category-badge">@Product.CategoryName</span>
            }
        </div>

        <h3 class="product-name">@Product.Name</h3>

        <p class="product-description">
            @(string.IsNullOrWhiteSpace(Product.Description)
                ? "Sản phẩm MiniLogistics"
                : Product.Description)
        </p>

        <div class="product-card-footer">
            <div class="product-price-block">
                @if (Product.VoucherPrice.HasValue && Product.MinPrice.HasValue)
                {
                    <span class="product-price-old">@FormatPrice(Product.MinPrice.Value)</span>
                    <span class="product-price">@FormatPrice(Product.VoucherPrice.Value)</span>
                    <span class="product-voucher-note">@Product.VoucherNote</span>
                }
                else if (Product.MinPrice.HasValue)
                {
                    <span class="product-price">@FormatPrice(Product.MinPrice.Value)</span>
                }
                <span class="product-shop">@ShopLabel</span>
            </div>
            <a href="@($"/products/{Product.Id}")"
               class="app-button app-button-primary app-button-sm"
               @onclick:stopPropagation="true">
                Xem
            </a>
        </div>
    </div>
</article>

@code {
    [Parameter, EditorRequired]
    public ProductItem Product { get; set; } = default!;

    private string Initial =>
        string.IsNullOrWhiteSpace(Product.Name)
            ? "P"
            : Product.Name.Trim()[0].ToString().ToUpperInvariant();

    private string ShopLabel =>
        string.IsNullOrWhiteSpace(Product.ShopName)
            ? $"Shop #{Product.ShopId}"
            : Product.ShopName;

    private bool imageFailed;

    protected override async Task OnInitializedAsync()
    {
        if (Product.MinPrice is not decimal price)
        {
            return;
        }

        var quote = await VoucherOffers.QuoteAsync(Product.Id, Product.ShopId, price);
        if (quote == null)
        {
            return;
        }

        Product.VoucherPrice = quote.Sale;
        Product.VoucherNote = quote.Note;
    }

    private void OnImageError() => imageFailed = true;

    private void Open() =>
        Navigation.NavigateTo($"/products/{Product.Id}");

    private static string FormatPrice(decimal price) =>
        string.Format(System.Globalization.CultureInfo.GetCultureInfo("vi-VN"), "{0:N0} ₫", price);
}
