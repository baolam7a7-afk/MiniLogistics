@inject SellerSession Session
@implements IDisposable

<aside class="seller-sidebar">
    <a class="seller-brand" href="/seller">
        <span class="seller-brand-mark">S</span>
        <span>
            <strong>Kênh Seller</strong>
            <span>@(Session.Shop?.Name ?? "MiniLogistics")</span>
        </span>
    </a>

    <div class="seller-nav-group">Vận hành</div>
    <NavLink class="seller-nav-link" href="/seller" Match="NavLinkMatch.All">Tổng quan</NavLink>
    <NavLink class="seller-nav-link" href="/seller/products">Sản phẩm</NavLink>
    <NavLink class="seller-nav-link" href="/seller/orders">Đơn hàng</NavLink>

    <div class="seller-nav-group">Cửa hàng</div>
    <NavLink class="seller-nav-link" href="/seller/shop">Cửa hàng</NavLink>
    <NavLink class="seller-nav-link" href="/seller/vouchers">Voucher</NavLink>
    <NavLink class="seller-nav-link" href="/seller/reviews">Đánh giá</NavLink>
    <NavLink class="seller-nav-link" href="/seller/support">
        Chat với admin
        @if (Session.SupportUnread > 0)
        {
            <span class="seller-chat-badge">@SellerText.CountBadge(Session.SupportUnread)</span>
        }
    </NavLink>
    <NavLink class="seller-nav-link" href="/seller/chat">
        Chat với khách hàng
        @if (Session.ChatUnread > 0)
        {
            <span class="seller-chat-badge">@SellerText.CountBadge(Session.ChatUnread)</span>
        }
    </NavLink>

    <div class="seller-nav-group">Tài chính</div>
    <NavLink class="seller-nav-link" href="/seller/revenue">Doanh thu</NavLink>
    <NavLink class="seller-nav-link" href="/seller/wallet">Ví</NavLink>
    <NavLink class="seller-nav-link" href="/seller/payouts">Rút tiền</NavLink>
</aside>

@code {
    protected override void OnInitialized() => Session.UiChanged += StateHasChanged;

    public void Dispose() => Session.UiChanged -= StateHasChanged;
}
