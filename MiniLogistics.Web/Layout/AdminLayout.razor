@inherits LayoutComponentBase
@implements IDisposable
@inject AdminSession Session
@inject ChatLiveService Live
@inject NavigationManager Navigation
@using MiniLogistics.Web.Services.Chat

@if (!Session.Ready)
{
    <div class="seller-boot">Đang kiểm tra quyền admin...</div>
}
else if (Session.Forbidden)
{
    <div class="seller-denied">
        <div class="seller-denied-card">
            <h1>Không có quyền Admin</h1>
            <p>Khu vực này chỉ mở cho tài khoản có role admin.</p>
            <a class="app-button app-button-primary" href="/">Về trang chủ</a>
        </div>
    </div>
}
else if (!string.IsNullOrWhiteSpace(Session.GateError) && Session.Profile == null)
{
    <div class="seller-denied">
        <div class="seller-denied-card">
            <h1>Không mở được trang Admin</h1>
            <p>@Session.GateError</p>
            <a class="app-button app-button-primary" href="/login">Đăng nhập</a>
        </div>
    </div>
}
else
{
    <div class="seller-shell @(Session.NavOpen ? "is-nav-open" : null)">
        <button type="button" class="seller-backdrop" @onclick="Session.CloseNav" aria-label="Đóng menu"></button>
        <AdminSidebar />
        <div class="seller-main">
            <AdminHeader />
            <main class="seller-content">
                @Body
            </main>
        </div>
    </div>
}

@code {
    private Func<ChatInboxNotice, Task>? onInbox;
    private Func<Task>? onRestored;
    private Func<Task>? onLink;
    private readonly HashSet<long> seenMessages = new();
    private string? notice;
    private string noticeHref = "/admin/chat";
    private int noticeVersion;

    protected override async Task OnInitializedAsync()
    {
        Session.UiChanged += StateHasChanged;
        onInbox = OnInboxAsync;
        onRestored = OnRestoredAsync;
        onLink = () => InvokeAsync(StateHasChanged);
        Live.InboxChanged += onInbox;
        Live.ConnectionRestored += onRestored;
        Live.LinkChanged += onLink;
        await Session.EnsureAsync();
    }

    private Task OnInboxAsync(ChatInboxNotice incoming)
    {
        if (incoming.MessageId > 0 && !seenMessages.Add(incoming.MessageId))
        {
            return Task.CompletedTask;
        }

        if (incoming.MessageId <= 0)
        {
            return OnRestoredAsync();
        }

        if (!incoming.FromCustomer || IsViewing(incoming.ConversationId))
        {
            return Task.CompletedTask;
        }

        var name = string.IsNullOrWhiteSpace(incoming.SenderName)
            ? "khách hàng"
            : incoming.SenderName.Trim();
        var product = string.IsNullOrWhiteSpace(incoming.ProductName)
            ? ""
            : "\n" + incoming.ProductName.Trim();
        var preview = incoming.Content.Length > 80
            ? incoming.Content[..80]
            : incoming.Content;

        return InvokeAsync(() =>
        {
            Session.NoteIncomingChat();
            notice = $"Tin nhắn mới\n{name}{product}\n\"{preview}\"";
            noticeHref = incoming.ConversationId > 0
                ? $"/admin/chat/{incoming.ConversationId}"
                : "/admin/chat";
            var version = ++noticeVersion;
            _ = HideNoticeAsync(version);
            _ = SyncUnreadAsync();
            StateHasChanged();
        });
    }

    private bool IsViewing(long conversationId)
    {
        if (conversationId <= 0)
        {
            return false;
        }

        var path = Navigation.ToBaseRelativePath(Navigation.Uri).TrimEnd('/');
        return path.Equals($"admin/chat/{conversationId}", StringComparison.OrdinalIgnoreCase);
    }

    private async Task SyncUnreadAsync()
    {
        try
        {
            await Session.RefreshChatUnreadAsync();
        }
        catch
        {
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task OnRestoredAsync()
    {
        try
        {
            await Session.RefreshChatUnreadAsync();
        }
        catch
        {
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task HideNoticeAsync(int version)
    {
        await Task.Delay(6000);
        if (version != noticeVersion)
        {
            return;
        }

        notice = null;
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        if (onInbox != null)
        {
            Live.InboxChanged -= onInbox;
        }

        if (onRestored != null)
        {
            Live.ConnectionRestored -= onRestored;
        }

        if (onLink != null)
        {
            Live.LinkChanged -= onLink;
        }

        Session.UiChanged -= StateHasChanged;
    }
}
