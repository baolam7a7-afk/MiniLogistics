@inherits LayoutComponentBase
@implements IDisposable

@using MiniLogistics.Web.Models.User
@using MiniLogistics.Web.Services.Auth
@using MiniLogistics.Web.Services.User

@inject AuthStateService AuthState
@inject TokenStorageService TokenStorage
@inject UserService UserService
@inject NavigationManager Navigation
@inject ChatLiveService Live
@using MiniLogistics.Web.Services.Chat

<div class="customer-layout" @onclick="CloseMenus">

    @if (isMenuOpen)
    {
        <div class="store-backdrop" @onclick="CloseMenus"></div>
    }

    <header class="store-header">
        <div class="store-header-inner">

            <button type="button"
                    class="store-menu-toggle"
                    aria-label="Mở menu"
                    @onclick="ToggleMobileNav"
                    @onclick:stopPropagation="true">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
                </svg>
            </button>

            <a href="/" class="store-brand" @onclick="CloseMenus">
                <span class="store-brand-mark">M</span>
                <span>
                    <span class="store-brand-name">MiniLogistics</span>
                    <span class="store-brand-tag">Mua sắm & giao hàng</span>
                </span>
            </a>

            <nav class="store-nav" aria-label="Điều hướng chính">
                <NavLink href="/" class="store-nav-link" Match="NavLinkMatch.All">Trang chủ</NavLink>
                <NavLink href="/products" class="store-nav-link">Sản phẩm</NavLink>
            </nav>

            <form class="store-search"
                  @onsubmit="SubmitHeaderSearch"
                  @onsubmit:preventDefault
                  @onclick:stopPropagation="true">
                <svg class="store-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="7" />
                    <path d="M20 20l-3.5-3.5" stroke-linecap="round" />
                </svg>
                <input type="search"
                       placeholder="Tìm sản phẩm, shop..."
                       value="@headerSearch"
                       @oninput="OnHeaderSearchInput"
                       aria-label="Tìm kiếm sản phẩm" />
            </form>

            <div class="store-actions">
                <NavLink href="/cart"
                         class="store-icon-btn"
                         title="Giỏ hàng"
                         @onclick="CloseMenus">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M6 6h15l-1.5 9h-12z" stroke-linejoin="round" />
                        <path d="M6 6L5 3H2" stroke-linecap="round" />
                        <circle cx="9" cy="20" r="1.5" fill="currentColor" stroke="none" />
                        <circle cx="18" cy="20" r="1.5" fill="currentColor" stroke="none" />
                    </svg>
                </NavLink>

                <div class="store-avatar-wrap" @onclick:stopPropagation="true">
                    <button type="button"
                            class="store-avatar-btn"
                            aria-expanded="@isMenuOpen"
                            aria-haspopup="menu"
                            @onclick="ToggleMenu">
                        @if (!string.IsNullOrWhiteSpace(AuthState.CurrentUser?.AvatarUrl))
                        {
                            <img src="@AuthState.CurrentUser.AvatarUrl"
                                 alt=""
                                 class="store-avatar store-avatar-img"
                                 @key="AuthState.CurrentUser.AvatarUrl" />
                        }
                        else
                        {
                            <span class="store-avatar">@GetAvatarLetter()</span>
                        }

                        <span class="store-avatar-meta">
                            <span class="store-avatar-name">@GetDisplayName()</span>
                            <span class="store-avatar-hint">Tài khoản</span>
                        </span>

                        <svg class="store-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </button>

                    @if (isMenuOpen)
                    {
                        <div class="store-dropdown" role="menu">
                            <div class="store-dropdown-label">Tài khoản</div>

                            <NavLink href="/profile" class="store-dropdown-item" @onclick="CloseMenus">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <circle cx="12" cy="8" r="4" />
                                    <path d="M4 20c1.5-3.5 4-5 8-5s6.5 1.5 8 5" />
                                </svg>
                                Hồ sơ của tôi
                            </NavLink>

                            <NavLink href="/vouchers" class="store-dropdown-item" @onclick="CloseMenus">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M4 9h16v10H4z" />
                                    <path d="M9 9V7a3 3 0 016 0v2" />
                                </svg>
                                Voucher
                            </NavLink>

                            <NavLink href="/chat" class="store-dropdown-item" @onclick="CloseMenus">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M4 6h16v10H8l-4 4V6z" />
                                </svg>
                                Chat với Shop
                            </NavLink>

                            <NavLink href="/orders" class="store-dropdown-item" @onclick="CloseMenus">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M4 7h16v12H4z" />
                                    <path d="M8 7V5a4 4 0 018 0v2" />
                                </svg>
                                Đơn hàng
                            </NavLink>

                            <NavLink href="/addresses" class="store-dropdown-item" @onclick="CloseMenus">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M12 21s7-5.2 7-11a7 7 0 10-14 0c0 5.8 7 11 7 11z" />
                                    <circle cx="12" cy="10" r="2.5" />
                                </svg>
                                Địa chỉ
                            </NavLink>

                            <NavLink href="/reviews" class="store-dropdown-item" @onclick="CloseMenus">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M12 3l2.4 4.9 5.4.8-3.9 3.8.9 5.4L12 15.9 7.2 18l.9-5.4L4.2 8.7l5.4-.8L12 3z" />
                                </svg>
                                Đánh giá
                            </NavLink>

                            <div class="store-dropdown-divider"></div>

                            <button type="button"
                                    class="store-dropdown-item danger"
                                    @onclick="Logout">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M10 7V5a2 2 0 012-2h7v18h-7a2 2 0 01-2-2v-2" />
                                    <path d="M15 12H3m0 0l3-3m-3 3l3 3" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                                Đăng xuất
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="store-mobile-panel @(isMobileNavOpen ? "open" : null)">
            <div class="store-mobile-nav">
                <NavLink href="/" class="store-nav-link" Match="NavLinkMatch.All" @onclick="CloseMenus">Trang chủ</NavLink>
                <NavLink href="/products" class="store-nav-link" @onclick="CloseMenus">Sản phẩm</NavLink>
                <NavLink href="/cart" class="store-nav-link" @onclick="CloseMenus">Giỏ hàng</NavLink>
            </div>
            <form class="store-mobile-search"
                  @onsubmit="SubmitHeaderSearch"
                  @onsubmit:preventDefault>
                <input type="search"
                       placeholder="Tìm sản phẩm..."
                       value="@headerSearch"
                       @oninput="OnHeaderSearchInput"
                       aria-label="Tìm kiếm sản phẩm" />
            </form>
        </div>
    </header>

    <main class="customer-main">
        <section class="customer-content @(IsHomePage ? "is-home" : null)">
            @Body
        </section>
    </main>

    <footer class="store-footer">
        <div class="store-footer-inner">
            <div><strong>MiniLogistics</strong> · Mua sắm nhanh, giao hàng tin cậy</div>
            <div>© 2026 MiniLogistics</div>
        </div>
    </footer>

</div>

@code {
    private bool isDisposed;
    private bool isLoadingProfile;
    private bool isMenuOpen;
    private bool isMobileNavOpen;
    private string headerSearch = string.Empty;

    private bool IsHomePage =>
        string.IsNullOrEmpty(
            Navigation.ToBaseRelativePath(Navigation.Uri)
                .Split('?', '#')[0]
                .Trim('/'));

    protected override void OnInitialized()
    {
        AuthState.OnChange += HandleAuthStateChanged;
        Navigation.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadCustomerProfileAsync();
        await Live.EnsureConnectedAsync();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        CloseMenus();
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task LoadCustomerProfileAsync()
    {
        if (isLoadingProfile)
            return;

        isLoadingProfile = true;

        try
        {
            var token = await TokenStorage.GetAccessTokenAsync();

            if (string.IsNullOrWhiteSpace(token))
            {
                Navigation.NavigateTo("/login", true);
                return;
            }

            var profile = await UserService.GetMyProfileAsync();

            if (profile is not null)
            {
                AuthState.UpdateUserProfile(
                    profile.FullName,
                    profile.AvatarUrl);
            }
        }
        catch (Exception)
        {
            // Keep AuthState if API fails temporarily.
        }
        finally
        {
            isLoadingProfile = false;
        }
    }

    private void HandleAuthStateChanged()
    {
        if (isDisposed)
            return;

        _ = InvokeAsync(StateHasChanged);
    }

    private void OnHeaderSearchInput(ChangeEventArgs e)
    {
        headerSearch = e.Value?.ToString() ?? string.Empty;
    }

    private void SubmitHeaderSearch()
    {
        var q = headerSearch.Trim();
        CloseMenus();

        if (string.IsNullOrWhiteSpace(q))
        {
            Navigation.NavigateTo("/products");
            return;
        }

        Navigation.NavigateTo($"/products?q={Uri.EscapeDataString(q)}");
    }

    private void ToggleMenu()
    {
        isMenuOpen = !isMenuOpen;
        if (isMenuOpen)
            isMobileNavOpen = false;
    }

    private void ToggleMobileNav()
    {
        isMobileNavOpen = !isMobileNavOpen;
        if (isMobileNavOpen)
            isMenuOpen = false;
    }

    private void CloseMenus()
    {
        isMenuOpen = false;
        isMobileNavOpen = false;
    }

    private string GetDisplayName()
    {
        var name = AuthState.CurrentUser?.FullName;

        if (!string.IsNullOrWhiteSpace(name))
            return name;

        return AuthState.CurrentUser?.Email ?? "Khách hàng";
    }

    private string GetAvatarLetter()
    {
        var name = AuthState.CurrentUser?.FullName;

        if (string.IsNullOrWhiteSpace(name))
            name = AuthState.CurrentUser?.Email;

        if (string.IsNullOrWhiteSpace(name))
            return "U";

        return name.Trim()[0].ToString().ToUpperInvariant();
    }

    private async Task Logout()
    {
        CloseMenus();
        await TokenStorage.ClearAsync();
        AuthState.Logout();
        Navigation.NavigateTo("/login", true);
    }

    public void Dispose()
    {
        isDisposed = true;
        AuthState.OnChange -= HandleAuthStateChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
