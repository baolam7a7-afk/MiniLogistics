@inherits LayoutComponentBase

@implements IDisposable

@using MiniLogistics.Web.Services.Auth

@inject AuthStateService AuthState
@inject TokenStorageService TokenStorage
@inject NavigationManager Navigation


<div class="app-shell">

    <!-- ========================= -->
    <!-- SIDEBAR -->
    <!-- ========================= -->

    <aside class="sidebar">

        <!-- LOGO -->

        <div class="sidebar-brand">

            <div class="brand-icon">
                🚚
            </div>

            <div>
                <div class="brand-title">
                    MiniLogistics
                </div>

                <div class="brand-subtitle">
                    MANAGEMENT SYSTEM
                </div>
            </div>

        </div>


        <!-- MENU -->

        <nav class="sidebar-menu">

            <div class="menu-section">
                MAIN
            </div>


            <NavLink href="/customer/dashboard"
                     class="menu-item"
                     Match="NavLinkMatch.All">

                <span class="menu-icon">🏠</span>

                <span>Dashboard</span>

            </NavLink>


            <NavLink href="/customer/products"
                     class="menu-item">

                <span class="menu-icon">🛍️</span>

                <span>Sản phẩm</span>

            </NavLink>


            <NavLink href="/customer/cart"
                     class="menu-item">

                <span class="menu-icon">🛒</span>

                <span>Giỏ hàng</span>

            </NavLink>


            <NavLink href="/customer/orders"
                     class="menu-item">

                <span class="menu-icon">📦</span>

                <span>Đơn hàng</span>

            </NavLink>


            <NavLink href="/customer/addresses"
                     class="menu-item">

                <span class="menu-icon">📍</span>

                <span>Địa chỉ</span>

            </NavLink>


            <div class="menu-section">
                ACCOUNT
            </div>


            <NavLink href="/change-password"
                     class="menu-item">

                <span class="menu-icon">🔐</span>

                <span>Đổi mật khẩu</span>

            </NavLink>

        </nav>


        <!-- SIDEBAR BOTTOM -->

        <div class="sidebar-bottom">

            @if (AuthState.IsAuthenticated)
            {
                <div class="sidebar-user">

                    <div class="user-avatar">

                        @GetAvatarLetter()

                    </div>


                    <div class="user-details">

                        <div class="user-name">

                            @(string.IsNullOrWhiteSpace(AuthState.FullName)
                                ? AuthState.Email
                                : AuthState.FullName)

                        </div>

                        <div class="user-email">

                            @AuthState.Email

                        </div>

                    </div>

                </div>


                <button class="logout-button"
                        @onclick="LogoutAsync">

                    <span>🚪</span>

                    <span>Đăng xuất</span>

                </button>
            }

        </div>

    </aside>


    <!-- ========================= -->
    <!-- MAIN AREA -->
    <!-- ========================= -->

    <main class="main-area">


        <!-- TOP BAR -->

        <header class="topbar">

            <div class="topbar-left">

                <div class="page-title">

                    MiniLogistics

                </div>

            </div>


            <div class="topbar-right">

                @if (AuthState.IsAuthenticated)
                {
                    <div class="role-badge">

                        @string.Join(", ", AuthState.Roles)

                    </div>


                    <div class="top-user">

                        <div class="top-avatar">

                            @GetAvatarLetter()

                        </div>


                        <div class="top-user-info">

                            <span class="top-user-name">

                                @(string.IsNullOrWhiteSpace(AuthState.FullName)
                                    ? AuthState.Email
                                    : AuthState.FullName)

                            </span>

                            <span class="top-user-role">

                                Customer

                            </span>

                        </div>

                    </div>
                }
                else
                {
                    <button class="login-button"
                            @onclick="GoToLogin">

                        Đăng nhập

                    </button>
                }

            </div>

        </header>


        <!-- CONTENT -->

        <section class="content-area">

            @if (!_initialized)
            {
                <div class="loading-container">

                    <div class="loading-spinner"></div>

                    <p>Đang tải...</p>

                </div>
            }
            else
            {
                @Body
            }

        </section>


        <!-- FOOTER -->

        <footer class="app-footer">

            <span>
                © 2026 MiniLogistics
            </span>

            <span>
                Logistics Management System
            </span>

        </footer>

    </main>

</div>


@code {

    private bool _initialized;


    protected override async Task OnInitializedAsync()
    {
        AuthState.AuthenticationStateChanged +=
            OnAuthenticationStateChanged;

        await AuthState.InitializeAsync();

        _initialized = true;
    }


    private void OnAuthenticationStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }


    private async Task LogoutAsync()
    {
        await TokenStorage.RemoveAuthAsync();

        AuthState.Clear();

        Navigation.NavigateTo(
            "/login",
            forceLoad: true);
    }


    private void GoToLogin()
    {
        Navigation.NavigateTo("/login");
    }


    private string GetAvatarLetter()
    {
        if (!string.IsNullOrWhiteSpace(AuthState.FullName))
        {
            return AuthState.FullName
                .Trim()
                .Substring(0, 1)
                .ToUpper();
        }

        if (!string.IsNullOrWhiteSpace(AuthState.Email))
        {
            return AuthState.Email
                .Trim()
                .Substring(0, 1)
                .ToUpper();
        }

        return "U";
    }


    public void Dispose()
    {
        AuthState.AuthenticationStateChanged -=
            OnAuthenticationStateChanged;
    }

}