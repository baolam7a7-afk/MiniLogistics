@using MiniLogistics.Web.Services.Auth

@inherits LayoutComponentBase

@inject AuthStateService AuthStateService
@inject AuthService AuthService
@inject NavigationManager Navigation

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">

        <a class="navbar-brand" href="">
            MiniLogistics
        </a>

    </div>
</div>

<input type="checkbox"
       title="Navigation menu"
       class="navbar-toggler" />

<div class="nav-scrollable"
     onclick="document.querySelector('.navbar-toggler').click()">

    <nav class="nav flex-column">

        <!-- Trang chủ -->
        <div class="nav-item px-3">

            <NavLink class="nav-link"
                     href=""
                     Match="NavLinkMatch.All">

                <span class="bi bi-house-door-fill"
                      aria-hidden="true">
                </span>

                Trang chủ

            </NavLink>

        </div>


        @if (AuthStateService.IsAuthenticated)
        {
            <!-- ========================= -->
            <!-- CUSTOMER -->
            <!-- ========================= -->

            @if (AuthStateService.HasRole("customer"))
            {
                <div class="nav-item px-3">

                    <NavLink class="nav-link"
                             href="/customer">

                        🛍️ Customer Dashboard

                    </NavLink>

                </div>
            }


            <!-- ========================= -->
            <!-- SELLER -->
            <!-- ========================= -->

            @if (AuthStateService.HasRole("seller"))
            {
                <div class="nav-item px-3">

                    <NavLink class="nav-link"
                             href="/seller">

                        🏪 Seller Dashboard

                    </NavLink>

                </div>
            }


            <!-- ========================= -->
            <!-- ADMIN -->
            <!-- ========================= -->

            @if (AuthStateService.HasRole("admin"))
            {
                <div class="nav-item px-3">

                    <NavLink class="nav-link"
                             href="/admin">

                        ⚙️ Admin Dashboard

                    </NavLink>

                </div>
            }


            <!-- ========================= -->
            <!-- SHIPPER -->
            <!-- ========================= -->

            @if (AuthStateService.HasRole("shipper"))
            {
                <div class="nav-item px-3">

                    <NavLink class="nav-link"
                             href="/shipper">

                        🚚 Shipper Dashboard

                    </NavLink>

                </div>
            }


            <!-- ========================= -->
            <!-- LOGOUT -->
            <!-- ========================= -->

            <div class="nav-item px-3 mt-3">

                <button class="btn btn-danger w-100"
                        @onclick="LogoutAsync"
                        disabled="@isLoggingOut">

                    @if (isLoggingOut)
                    {
                        <span>
                            Đang đăng xuất...
                        </span>
                    }
                    else
                    {
                        <span>
                            🚪 Đăng xuất
                        </span>
                    }

                </button>

            </div>
        }
        else
        {
            <!-- ========================= -->
            <!-- CHƯA ĐĂNG NHẬP -->
            <!-- ========================= -->

            <div class="nav-item px-3">

                <NavLink class="nav-link"
                         href="/login">

                    🔐 Đăng nhập

                </NavLink>

            </div>

            <div class="nav-item px-3">

                <NavLink class="nav-link"
                         href="/register">

                    📝 Đăng ký

                </NavLink>

            </div>
        }

    </nav>

</div>


@code {

    private bool isLoggingOut;


    protected override async Task OnInitializedAsync()
    {
        await AuthStateService.InitializeAsync();
    }


    private async Task LogoutAsync()
    {
        if (isLoggingOut)
        {
            return;
        }

        isLoggingOut = true;

        try
        {
            // Gọi Backend Logout
            // Backend sẽ revoke Refresh Token
            await AuthService.LogoutAsync();
        }
        finally
        {
            // Xóa trạng thái authentication trên frontend
            AuthStateService.Clear();

            isLoggingOut = false;

            // Chuyển về Login
            Navigation.NavigateTo(
                "/login",
                forceLoad: true);
        }
    }
}