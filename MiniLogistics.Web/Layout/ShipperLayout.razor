@inherits LayoutComponentBase
@implements IDisposable
@inject ShipperSession Session
@inject ShipperOrderLiveService OrdersLive
@inject TokenStorageService TokenStorage
@inject AuthStateService AuthState
@inject NavigationManager Navigation

@if (!Session.Ready)
{
    <div class="shipper-boot">Đang kiểm tra quyền shipper...</div>
}
else if (Session.Forbidden)
{
    <div class="shipper-denied">
        <div class="shipper-denied-card">
            <h1>Không có quyền Shipper</h1>
            <p>Khu vực này chỉ mở cho tài khoản có role shipper.</p>
            <a class="app-button app-button-primary" href="/">Về trang chủ</a>
        </div>
    </div>
}
else if (Session.Profile == null)
{
    <div class="shipper-denied">
        <div class="shipper-denied-card">
            <h1>Không mở được kênh giao hàng</h1>
            <p>@(Session.GateError ?? "Không tải được tài khoản.")</p>
            <a class="app-button app-button-primary" href="/login">Đăng nhập</a>
        </div>
    </div>
}
else
{
    <div class="shipper-shell">
        <aside class="shipper-sidebar">
            <a href="/shipper"><strong>Kênh giao hàng</strong></a>
            <NavLink href="/shipper" Match="NavLinkMatch.All">Tổng quan</NavLink>
            <NavLink href="/shipper/shipments">Đơn giao</NavLink>
            <NavLink href="/shipper/profile">Tài khoản</NavLink>
            <button type="button" class="app-button app-button-secondary" @onclick="Logout">Đăng xuất</button>
        </aside>
        <div>
            <header class="shipper-top">
                <a href="/shipper">
                    @if (!string.IsNullOrWhiteSpace(Session.Profile.AvatarUrl))
                    {
                        <img src="@Session.Profile.AvatarUrl" alt="" style="width:32px;height:32px;border-radius:50%;object-fit:cover" />
                    }
                    MiniLogistics
                    <span>@(Session.Profile.FullName ?? Session.Profile.Email)</span>
                </a>
                <button type="button" class="app-button app-button-secondary" @onclick="Logout">Đăng xuất</button>
            </header>
            <main class="shipper-content">
                @Body
            </main>
            <nav class="shipper-bottom">
                <NavLink href="/shipper" Match="NavLinkMatch.All">Tổng quan</NavLink>
                <NavLink href="/shipper/shipments">Đơn giao</NavLink>
                <NavLink href="/shipper/profile">Tài khoản</NavLink>
                <button type="button" @onclick="Logout">Thoát</button>
            </nav>
        </div>
    </div>
}

@code {
    protected override async Task OnInitializedAsync()
    {
        Session.UiChanged += StateHasChanged;
        await Session.EnsureAsync();
        if (Session.Profile != null)
        {
            await OrdersLive.EnsureConnectedAsync();
        }
    }

    private async Task Logout()
    {
        await TokenStorage.ClearAsync();
        AuthState.Logout();
        Navigation.NavigateTo("/login");
    }

    public void Dispose() => Session.UiChanged -= StateHasChanged;
}
