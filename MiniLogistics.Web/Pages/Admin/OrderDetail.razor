@page "/admin/orders/{OrderId:long}"
@layout AdminLayout
@using MiniLogistics.Web.Components
@using MiniLogistics.Web.Services.Product
@inject SellerApi Api
@inject AdminSession Session

<PageTitle>Chi tiết đơn</PageTitle>

<div class="seller-page-head">
    <div>
        <h1>@(order?.OrderCode ?? "Chi tiết đơn")</h1>
        <p><a href="/admin/orders">Quay lại danh sách</a></p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="app-alert @(isError ? "app-alert-danger" : "app-alert-success")">@message</div>
}

@if (isLoading)
{
    <div class="seller-loading">Đang tải đơn...</div>
}
else if (order == null)
{
    <div class="seller-empty">Không tìm thấy đơn.</div>
}
else
{
    <section class="seller-card">
        <h2>@SellerText.OrderStatus(order.Status)</h2>
        <OrderFlow Status="@order.Status" CancelReason="@order.CancelReason" />
        <p>Khách: <strong>@(order.CustomerName ?? $"#{order.CustomerId}")</strong> · @(order.CustomerPhone ?? "—")</p>
        <p>Địa chỉ: @(order.ShippingAddressText ?? "—")</p>
        <p>Shop: @(order.ShopName ?? $"#{order.ShopId}")</p>
        <p>Đặt lúc: <strong>@SellerText.When(order.PlacedAt)</strong></p>
        <p>Tạm tính @SellerText.Money(order.Subtotal) · Phí ship @SellerText.Money(order.ShippingFee) · Giảm @SellerText.Money(order.DiscountTotal)</p>
        <p>Tổng <strong>@SellerText.Money(order.Total)</strong> · @order.PaymentMethod</p>
        @if (order.ConfirmedAt.HasValue)
        {
            <p class="seller-muted">Shop xác nhận lúc @SellerText.When(order.ConfirmedAt.Value)</p>
        }
        @if (!string.IsNullOrWhiteSpace(order.Note))
        {
            <p>Ghi chú: @order.Note</p>
        }
    </section>

    <section class="seller-card">
        <h2>Sản phẩm</h2>
        @if (order.Items.Count == 0)
        {
            <p class="seller-muted">Đơn không có dòng sản phẩm trong phản hồi.</p>
        }
        else
        {
            <div class="seller-table-wrap">
                <table class="seller-table">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Sản phẩm</th>
                            <th>Biến thể</th>
                            <th>Giá</th>
                            <th>SL</th>
                            <th>Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in order.Items)
                        {
                            <tr>
                                <td><img class="order-line-image" src="@VariantImages.Resolve(item.VariantName, item.ImageUrl)" alt="" /></td>
                                <td>@item.ProductName</td>
                                <td>@item.VariantName</td>
                                <td>@SellerText.Money(item.UnitPrice)</td>
                                <td>@item.Quantity</td>
                                <td>@SellerText.Money(item.LineTotal)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    @if (CanAct)
    {
        <section class="seller-card">
            <h2>Xử lý đơn</h2>
            <p class="seller-muted">Cùng quyền với seller: xác nhận hoặc hủy khi đơn đang chờ. Không đổi trạng thái giao hàng.</p>
            <div class="seller-actions">
                <button class="app-button app-button-primary" disabled="@isSaving" @onclick="Confirm">Xác nhận đơn</button>
                <button class="app-button app-button-danger" disabled="@isSaving" @onclick="OpenCancel">Hủy đơn</button>
            </div>
        </section>
    }

    @if (order.StatusLogs.Count > 0)
    {
        <section class="seller-card">
            <h2>Lịch sử</h2>
            <div class="seller-table-wrap">
                <table class="seller-table">
                    <thead>
                        <tr>
                            <th>Từ</th>
                            <th>Đến</th>
                            <th>Ghi chú</th>
                            <th>Lúc</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in order.StatusLogs)
                        {
                            <tr>
                                <td>@SellerText.OrderStatus(log.FromStatus)</td>
                                <td>@SellerText.OrderStatus(log.ToStatus)</td>
                                <td>@(log.Message ?? "—")</td>
                                <td>@SellerText.When(log.CreatedAt)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
}

@if (showCancel)
{
    <div class="order-modal-backdrop">
        <div class="order-modal">
            <h3>Hủy đơn</h3>
            <p>Nhập lý do hủy. Khách hàng sẽ thấy lý do này.</p>
            <textarea class="seller-input" rows="4" @bind="cancelReason" maxlength="500" placeholder="Lý do hủy"></textarea>
            <div class="order-modal-actions">
                <button class="app-button app-button-secondary" @onclick="CloseCancel">Đóng</button>
                <button class="app-button app-button-danger" disabled="@(isSaving || string.IsNullOrWhiteSpace(cancelReason))" @onclick="Cancel">Xác nhận hủy</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public long OrderId { get; set; }

    private SellerOrder? order;
    private bool isLoading = true;
    private bool isSaving;
    private bool isError;
    private bool showCancel;
    private string? message;
    private string cancelReason = "";

    private bool CanAct
    {
        get
        {
            var status = order?.Status?.Trim().ToLowerInvariant();
            return status is "pending" or "paid";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (Session.Forbidden || Session.Profile == null)
        {
            isLoading = false;
            return;
        }

        isLoading = true;
        var result = await Api.GetAsync<SellerOrder>($"api/orders/{OrderId}");
        isLoading = false;
        if (!result.Ok || result.Data == null)
        {
            isError = true;
            message = result.Error;
            order = null;
            return;
        }

        order = result.Data;
    }

    private async Task Confirm()
    {
        isSaving = true;
        var result = await Api.PostAsync<SellerOrder>($"api/orders/{OrderId}/confirm");
        isSaving = false;
        isError = !result.Ok;
        message = result.Ok ? "Đã xác nhận đơn." : result.Error;
        if (result.Data != null)
        {
            order = result.Data;
        }
    }

    private void OpenCancel()
    {
        cancelReason = "";
        showCancel = true;
    }

    private void CloseCancel() => showCancel = false;

    private async Task Cancel()
    {
        if (string.IsNullOrWhiteSpace(cancelReason))
        {
            return;
        }

        isSaving = true;
        var result = await Api.PostAsync<SellerOrder>($"api/orders/{OrderId}/shop-cancel", new { Reason = cancelReason.Trim() });
        isSaving = false;
        isError = !result.Ok;
        message = result.Ok ? "Đã hủy đơn." : result.Error;
        if (result.Ok)
        {
            showCancel = false;
            order = result.Data ?? order;
        }
    }
}
