@page "/admin/profile"
@layout AdminLayout
@inject SellerApi Api
@inject AdminSession Session
@inject TokenStorageService TokenStorage
@inject AuthStateService AuthState
@inject NavigationManager Navigation

<PageTitle>Hồ sơ Admin</PageTitle>

<div class="seller-page-head">
    <div>
        <h1>Hồ sơ</h1>
        <p>Thông tin tài khoản admin đang đăng nhập.</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="app-alert @(isError ? "app-alert-danger" : "app-alert-success")">@message</div>
}

@if (isLoading)
{
    <div class="seller-loading">Đang tải hồ sơ...</div>
}
else if (profile == null)
{
    <div class="seller-empty">Không có dữ liệu tài khoản.</div>
}
else
{
    <section class="seller-card">
        <p>Email: <strong>@profile.Email</strong></p>
        <p>Role: <strong>@string.Join(", ", profile.Roles)</strong></p>
        <p>Trạng thái: <strong>@AdminText.UserStatus(profile.Status)</strong></p>
        <div class="seller-form">
            <label>Họ tên
                <input class="seller-input" @bind="fullName" />
            </label>
            <label>Số điện thoại
                <input class="seller-input" @bind="phone" />
            </label>
            <AccountAvatarUpload CurrentUrl="@profile.AvatarUrl"
                                 InputClass="seller-input"
                                 HintClass="seller-muted"
                                 ActionsClass="seller-actions"
                                 AvatarSaved="OnAvatarSaved" />
            <div class="seller-actions">
                <button class="app-button app-button-primary" @onclick="Save">Lưu hồ sơ</button>
                <button class="app-button app-button-danger" @onclick="Logout">Đăng xuất</button>
            </div>
        </div>
    </section>
}

@code {
    private UserProfile? profile;
    private string fullName = "";
    private string? phone;
    private bool isLoading = true;
    private bool isError;
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureAsync();
        var result = await Api.GetAsync<UserProfile>("api/users/me");
        isLoading = false;
        if (!result.Ok || result.Data == null)
        {
            isError = true;
            message = result.Error;
            return;
        }

        profile = result.Data;
        fullName = profile.FullName ?? "";
        phone = profile.Phone;
    }

    private void OnAvatarSaved(string url)
    {
        if (profile != null)
        {
            profile.AvatarUrl = url;
        }

        AuthState.UpdateUserProfile(fullName, url);
        Session.ApplyAvatar(url);
    }

    private async Task Save()
    {
        var result = await Api.PutAsync<UserProfile>("api/users/me", new
        {
            FullName = fullName,
            Phone = phone
        });
        isError = !result.Ok;
        message = result.Ok ? "Đã lưu hồ sơ." : result.Error;
        if (result.Data != null)
        {
            profile = result.Data;
            AuthState.UpdateUserProfile(profile.FullName, profile.AvatarUrl);
        }
    }

    private async Task Logout()
    {
        await TokenStorage.ClearAsync();
        AuthState.Logout();
        Navigation.NavigateTo("/login");
    }
}
