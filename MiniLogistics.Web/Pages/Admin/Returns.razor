@page "/admin/returns"
@layout AdminLayout
@inject SellerApi Api
@inject AdminSession Session

<PageTitle>Trả hàng</PageTitle>

<div class="seller-page-head">
    <div>
        <h1>Yêu cầu trả hàng</h1>
        <p>Duyệt hoặc từ chối khi yêu cầu còn chờ xử lý.</p>
    </div>
</div>

<div class="seller-filters">
    <select class="seller-select" @bind="status">
        <option value="">Mọi trạng thái</option>
        <option value="requested">Chờ xử lý</option>
        <option value="approved">Đã duyệt</option>
        <option value="rejected">Từ chối</option>
    </select>
    <button class="app-button app-button-secondary" @onclick="Search">Lọc</button>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="app-alert @(isError ? "app-alert-danger" : "app-alert-success")">@message</div>
}

@if (isLoading)
{
    <div class="seller-loading">Đang tải yêu cầu trả hàng...</div>
}
else if (items.Count == 0)
{
    <div class="seller-empty">Không có yêu cầu trả hàng.</div>
}
else
{
    <section class="seller-card">
        <div class="seller-table-wrap">
            <table class="seller-table">
                <thead>
                    <tr>
                        <th>Đơn</th>
                        <th>Khách</th>
                        <th>Lý do</th>
                        <th>Trạng thái</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in items)
                    {
                        <tr>
                            <td>@item.OrderCode</td>
                            <td>@item.CustomerEmail</td>
                            <td>@item.Reason</td>
                            <td><span class="seller-badge">@SellerText.ReturnStatus(item.Status)</span></td>
                            <td>
                                @if (item.Status == "requested")
                                {
                                    <div class="seller-actions">
                                        <button class="app-button app-button-primary" @onclick="() => Approve(item.Id)">Duyệt</button>
                                        <button class="app-button app-button-danger" @onclick="() => Reject(item.Id)">Từ chối</button>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <AdminPager Page="pageIndex" TotalPages="totalPages" PageChanged="GoPage" />
    </section>
}

@code {
    private List<ReturnRecord> items = new();
    private int pageIndex = 1;
    private int totalPages;
    private string status = "";
    private bool isLoading = true;
    private bool isError;
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureAsync();
        await LoadAsync();
    }

    private async Task Search()
    {
        pageIndex = 1;
        await LoadAsync();
    }

    private async Task GoPage(int next)
    {
        pageIndex = next;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (Session.Forbidden || Session.Profile == null)
        {
            isLoading = false;
            return;
        }

        isLoading = true;
        var query = $"api/return-requests?Page={pageIndex}&PageSize=10";
        if (!string.IsNullOrWhiteSpace(status))
        {
            query += $"&Status={Uri.EscapeDataString(status)}";
        }

        var result = await Api.GetAsync<PagedResult<ReturnRecord>>(query);
        isLoading = false;
        if (!result.Ok || result.Data == null)
        {
            isError = true;
            message = result.Error;
            items = new();
            return;
        }

        items = result.Data.Items;
        totalPages = result.Data.TotalPages;
    }

    private async Task Approve(long id)
    {
        var result = await Api.PutAsync<ReturnRecord>($"api/return-requests/{id}/approve");
        isError = !result.Ok;
        message = result.Ok ? "Đã duyệt trả hàng." : result.Error;
        await LoadAsync();
    }

    private async Task Reject(long id)
    {
        var result = await Api.PutAsync<ReturnRecord>($"api/return-requests/{id}/reject");
        isError = !result.Ok;
        message = result.Ok ? "Đã từ chối trả hàng." : result.Error;
        await LoadAsync();
    }
}
