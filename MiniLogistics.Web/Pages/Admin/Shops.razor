@page "/admin/shops"
@layout AdminLayout
@inject SellerApi Api
@inject AdminSession Session

<PageTitle>Cửa hàng</PageTitle>

<div class="seller-page-head">
    <div>
        <h1>Cửa hàng</h1>
        <p>Duyệt hoặc từ chối shop đang chờ. API chỉ có hai thao tác này cho admin.</p>
    </div>
</div>

<div class="seller-filters">
    <input class="seller-input" placeholder="Tên shop" @bind="search" />
    <select class="seller-select" @bind="status">
        <option value="">Mọi trạng thái</option>
        <option value="pending">Chờ duyệt</option>
        <option value="approved">Đã duyệt</option>
        <option value="rejected">Từ chối</option>
        <option value="suspended">Ngừng bán</option>
    </select>
    <button class="app-button app-button-secondary" @onclick="Search">Lọc</button>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="app-alert @(isError ? "app-alert-danger" : "app-alert-success")">@message</div>
}

@if (isLoading)
{
    <div class="seller-loading">Đang tải cửa hàng...</div>
}
else if (items.Count == 0)
{
    <div class="seller-empty">Không có cửa hàng phù hợp.</div>
}
else
{
    <section class="seller-card">
        <div class="seller-table-wrap">
            <table class="seller-table">
                <thead>
                    <tr>
                        <th>Shop</th>
                        <th>Chủ</th>
                        <th>Ví</th>
                        <th>Trạng thái</th>
                        <th>Tạo lúc</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var shop in items)
                    {
                        <tr>
                            <td>
                                <a href="@($"/admin/shops/{shop.Id}")"><strong>@shop.Name</strong></a>
                                <div class="seller-muted">@shop.Slug</div>
                            </td>
                            <td>#@shop.OwnerUserId</td>
                            <td>@SellerText.Money(WalletOf(shop.Id))</td>
                            <td><span class="seller-badge">@SellerText.ShopStatus(shop.Status)</span></td>
                            <td>@SellerText.When(shop.CreatedAt)</td>
                            <td>
                                @if (shop.Status == "pending")
                                {
                                    <div class="seller-actions">
                                        <button class="app-button app-button-primary" @onclick="() => Approve(shop.Id)">Duyệt</button>
                                        <button class="app-button app-button-danger" @onclick="() => Reject(shop.Id)">Từ chối</button>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <AdminPager Page="pageIndex" TotalPages="totalPages" PageChanged="GoPage" />
    </section>
}

@code {
    private List<ShopRecord> items = new();
    private int pageIndex = 1;
    private int totalPages;
    private string search = "";
    private string status = "";
    private bool isLoading = true;
    private bool isError;
    private string? message;
    private Dictionary<long, decimal> wallets = new();

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureAsync();
        await LoadAsync();
    }

    private async Task Search()
    {
        pageIndex = 1;
        await LoadAsync();
    }

    private async Task GoPage(int next)
    {
        pageIndex = next;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (Session.Forbidden || Session.Profile == null)
        {
            isLoading = false;
            return;
        }

        isLoading = true;
        var query = $"api/shops?Page={pageIndex}&PageSize=10";
        if (!string.IsNullOrWhiteSpace(search))
        {
            query += $"&Search={Uri.EscapeDataString(search)}";
        }
        if (!string.IsNullOrWhiteSpace(status))
        {
            query += $"&Status={Uri.EscapeDataString(status)}";
        }

        var result = await Api.GetAsync<PagedResult<ShopRecord>>(query);
        isLoading = false;
        if (!result.Ok || result.Data == null)
        {
            isError = true;
            message = result.Error;
            items = new();
            return;
        }

        items = result.Data.Items;
        totalPages = result.Data.TotalPages;
        var walletResult = await Api.GetAsync<List<ShopWalletRecord>>("api/shop-wallets");
        wallets = walletResult.Data?.ToDictionary(item => item.ShopId, item => item.Balance) ?? new();
    }

    private decimal WalletOf(long shopId) =>
        wallets.TryGetValue(shopId, out var balance) ? balance : 0;

    private async Task Approve(long id)
    {
        var result = await Api.PutAsync<ShopRecord>($"api/shops/{id}/approve");
        isError = !result.Ok;
        message = result.Ok ? "Đã duyệt cửa hàng." : result.Error;
        await LoadAsync();
    }

    private async Task Reject(long id)
    {
        var result = await Api.PutAsync<ShopRecord>($"api/shops/{id}/reject");
        isError = !result.Ok;
        message = result.Ok ? "Đã từ chối cửa hàng." : result.Error;
        await LoadAsync();
    }
}
