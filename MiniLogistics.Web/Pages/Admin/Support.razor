@page "/admin/support"
@page "/admin/support/{TicketId:long}"
@layout AdminLayout
@inject SellerApi Api
@inject AdminSession Session

<PageTitle>Hỗ trợ</PageTitle>

<div class="seller-page-head">
    <div>
        <h1>Hỗ trợ</h1>
        <p>Admin xem mọi ticket và cập nhật trạng thái. Trả lời gửi qua API tin nhắn hỗ trợ.</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="app-alert @(isError ? "app-alert-danger" : "app-alert-success")">@message</div>
}

@if (isLoading)
{
    <div class="seller-loading">Đang tải ticket...</div>
}
else if (items.Count == 0)
{
    <div class="seller-empty">Chưa có ticket.</div>
}
else
{
    <section class="seller-card">
        <div class="seller-table-wrap">
            <table class="seller-table">
                <thead>
                    <tr>
                        <th>Tiêu đề</th>
                        <th>Người tạo</th>
                        <th>Đơn</th>
                        <th>Trạng thái</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in items)
                    {
                        <tr>
                            <td>@item.Subject</td>
                            <td>#@item.CreatedByUserId</td>
                            <td>@(item.OrderId?.ToString() ?? "—")</td>
                            <td>
                                <select class="seller-select" value="@item.Status" @onchange="args => UpdateStatus(item, args)">
                                    <option value="open">Mở</option>
                                    <option value="in_progress">Đang xử lý</option>
                                    <option value="resolved">Đã xử lý</option>
                                    <option value="closed">Đã đóng</option>
                                </select>
                            </td>
                            <td><a href="@($"/admin/support/{item.Id}")">Xem</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <AdminPager Page="pageIndex" TotalPages="totalPages" PageChanged="GoPage" />
    </section>
}

@if (TicketId.HasValue)
{
    <section class="seller-card">
        <h2>Ticket #@TicketId</h2>
        @foreach (var note in messages)
        {
            <p><strong>#@note.SenderUserId</strong> · @SellerText.When(note.CreatedAt)<br />@note.Message</p>
        }
        <label class="seller-field">Trả lời
            <textarea class="seller-input" @bind="reply"></textarea>
        </label>
        <button class="app-button app-button-primary" @onclick="Send">Gửi</button>
    </section>
}

@code {
    [Parameter] public long? TicketId { get; set; }

    private List<SupportTicketRecord> items = new();
    private List<SupportMessageRecord> messages = new();
    private int pageIndex = 1;
    private int totalPages;
    private string reply = "";
    private bool isLoading = true;
    private bool isError;
    private string? message;

    protected override async Task OnParametersSetAsync()
    {
        await Session.EnsureAsync();
        await LoadAsync();
        if (TicketId.HasValue)
        {
            await LoadMessages();
        }
    }

    private async Task GoPage(int next)
    {
        pageIndex = next;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (Session.Forbidden || Session.Profile == null)
        {
            isLoading = false;
            return;
        }

        isLoading = true;
        var result = await Api.GetAsync<PagedResult<SupportTicketRecord>>($"api/support-tickets?Page={pageIndex}&PageSize=10");
        isLoading = false;
        if (!result.Ok || result.Data == null)
        {
            isError = true;
            message = result.Error;
            items = new();
            return;
        }

        items = result.Data.Items;
        totalPages = result.Data.TotalPages;
    }

    private async Task LoadMessages()
    {
        var result = await Api.GetAsync<PagedResult<SupportMessageRecord>>(
            $"api/support-messages/ticket/{TicketId}?Page=1&PageSize=50");
        messages = result.Data?.Items ?? new();
        if (!result.Ok)
        {
            isError = true;
            message = result.Error;
        }
    }

    private async Task UpdateStatus(SupportTicketRecord item, ChangeEventArgs args)
    {
        var next = args.Value?.ToString();
        if (string.IsNullOrWhiteSpace(next) || next == item.Status)
        {
            return;
        }

        var result = await Api.PutAsync<SupportTicketRecord>($"api/support-tickets/{item.Id}", new
        {
            Subject = item.Subject,
            Status = next
        });
        isError = !result.Ok;
        message = result.Ok ? "Đã cập nhật ticket." : result.Error;
        await LoadAsync();
    }

    private async Task Send()
    {
        if (!TicketId.HasValue || string.IsNullOrWhiteSpace(reply))
        {
            return;
        }

        var result = await Api.PostAsync<SupportMessageRecord>("api/support-messages", new
        {
            TicketId,
            Message = reply
        });
        isError = !result.Ok;
        message = result.Ok ? "Đã gửi trả lời." : result.Error;
        if (result.Ok)
        {
            reply = "";
            await LoadMessages();
        }
    }
}
