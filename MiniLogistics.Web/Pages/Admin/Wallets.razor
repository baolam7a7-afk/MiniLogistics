@page "/admin/wallets"
@layout AdminLayout
@inject SellerApi Api
@inject AdminSession Session

<PageTitle>Ví shop</PageTitle>

<div class="seller-page-head">
    <div>
        <h1>Ví shop</h1>
        <p>Số dư hiện có của từng cửa hàng.</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="app-alert app-alert-danger">@message</div>
}

@if (isLoading)
{
    <div class="seller-loading">Đang tải ví...</div>
}
else if (items.Count == 0)
{
    <div class="seller-empty">Chưa có cửa hàng.</div>
}
else
{
    <section class="seller-card">
        <div class="seller-table-wrap">
            <table class="seller-table">
                <thead>
                    <tr>
                        <th>Cửa hàng</th>
                        <th>Số dư</th>
                        <th>Cập nhật</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in items)
                    {
                        <tr>
                            <td>@item.ShopName</td>
                            <td>@SellerText.Money(item.Balance)</td>
                            <td>@(item.UpdatedAt.HasValue ? SellerText.When(item.UpdatedAt.Value) : "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}

@code {
    private List<ShopWalletRecord> items = new();
    private bool isLoading = true;
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureAsync();
        if (Session.Forbidden || Session.Profile == null)
        {
            isLoading = false;
            return;
        }

        var result = await Api.GetAsync<List<ShopWalletRecord>>("api/shop-wallets");
        isLoading = false;
        if (!result.Ok || result.Data == null)
        {
            message = result.Error;
            items = new();
            return;
        }

        items = result.Data;
    }
}
