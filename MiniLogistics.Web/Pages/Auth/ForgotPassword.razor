@page "/forgot-password"
@layout AuthLayout
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Quên mật khẩu - MiniLogistics</PageTitle>

<div class="login-page">
    <div class="login-header">
        <h1>Quên mật khẩu</h1>
        <p>Nhập email tài khoản. Hệ thống tạo mã đặt lại mật khẩu.</p>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="auth-alert auth-alert-error">@errorMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(resetToken))
    {
        <div class="auth-alert auth-alert-success">
            Đã tạo mã. Email chưa được gửi, dùng mã này để đặt lại mật khẩu.
        </div>
        <p class="auth-field"><strong>@resetToken</strong></p>
        <button type="button" class="auth-submit" @onclick="GoReset">Đặt lại mật khẩu</button>
    }
    else
    {
        <EditForm Model="model" OnValidSubmit="Submit">
            <div class="auth-field">
                <label>Email</label>
                <InputText @bind-Value="model.Email" type="email" class="auth-input" placeholder="you@email.com" />
            </div>
            <button type="submit" class="auth-submit" disabled="@isLoading">
                @(isLoading ? "Đang gửi..." : "Tạo mã đặt lại")
            </button>
        </EditForm>
    }

    <div class="auth-register">
        <a href="/login">Về đăng nhập</a>
    </div>
</div>

@code {
    private ForgotPasswordRequest model = new();
    private bool isLoading;
    private string? errorMessage;
    private string? resetToken;

    private async Task Submit()
    {
        errorMessage = null;
        isLoading = true;
        var result = await AuthService.ForgotPasswordAsync(model);
        isLoading = false;
        if (!result.Ok || string.IsNullOrWhiteSpace(result.ResetToken))
        {
            errorMessage = result.Error ?? "Không tạo được mã đặt lại mật khẩu.";
            return;
        }

        resetToken = result.ResetToken;
    }

    private void GoReset() =>
        Navigation.NavigateTo($"/reset-password?token={Uri.EscapeDataString(resetToken ?? "")}");
}
