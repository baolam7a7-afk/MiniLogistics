@page "/login"
@layout AuthLayout
@implements IAsyncDisposable

@using Microsoft.JSInterop
@using System.Net.Http.Json

@inject AuthService AuthService
@inject TokenStorageService TokenStorage
@inject AuthStateService AuthState
@inject NavigationManager Navigation
@inject IJSRuntime Js
@inject IConfiguration Configuration
@inject HttpClient Http

<PageTitle>Đăng nhập - MiniLogistics</PageTitle>

<div class="login-page">

    <div class="login-header">
        <h1>Welcome back</h1>
        <p>Đăng nhập vào tài khoản MiniLogistics</p>
    </div>

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="auth-alert auth-alert-success">@successMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="auth-alert auth-alert-error">@errorMessage</div>
    }

    <EditForm Model="loginModel" OnValidSubmit="HandleLogin">
        <DataAnnotationsValidator />

        <div class="auth-field">
            <label>Email</label>
            <InputText @bind-Value="loginModel.Email" type="email" class="auth-input"
                       placeholder="you@email.com" />
            <ValidationMessage For="() => loginModel.Email" />
        </div>

        <div class="auth-field">
            <div class="auth-label-row">
                <label>Mật khẩu</label>
                <a href="/forgot-password">Quên mật khẩu?</a>
            </div>

            <div class="password-wrapper">
                <InputText @bind-Value="loginModel.Password" type="@passwordInputType" class="auth-input"
                           placeholder="••••••••" />
                <button type="button" class="password-toggle" @onclick="TogglePassword">
                    @(showPassword ? "Ẩn" : "Hiện")
                </button>
            </div>
            <ValidationMessage For="() => loginModel.Password" />
        </div>

        <button type="submit" class="auth-submit" disabled="@isLoading">
            @(isLoading ? "Đang đăng nhập..." : "Đăng nhập")
        </button>
    </EditForm>

    <div class="auth-divider">
        <span>hoặc</span>
    </div>

    <div id="google-login-button" class="google-button-host"></div>

    <div class="auth-register">
        <span>Chưa có tài khoản?</span>
        <a href="/register">Đăng ký ngay</a>
    </div>

</div>

@code {
    private LoginRequest loginModel = new();
    private bool isLoading;
    private bool showPassword;
    private bool googleReady;
    private string? errorMessage;
    private string? successMessage;
    private DotNetObjectReference<Login>? dotNetRef;

    private string passwordInputType =>
        showPassword ? "text" : "password";

    protected override void OnInitialized()
    {
        CheckRegisterSuccessMessage();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || googleReady)
            return;

        try
        {
            var clientId = Configuration["Google:ClientId"];
            if (string.IsNullOrWhiteSpace(clientId))
                return;

            dotNetRef = DotNetObjectReference.Create(this);
            googleReady = await Js.InvokeAsync<bool>(
                "googleAuth.initialize",
                clientId,
                dotNetRef);
            StateHasChanged();
        }
        catch
        {
            googleReady = false;
        }
    }

    private void CheckRegisterSuccessMessage()
    {
        var query = Navigation.ToAbsoluteUri(Navigation.Uri).Query;
        if (query.Contains("registered=true", StringComparison.OrdinalIgnoreCase))
        {
            successMessage =
                "Đăng ký tài khoản thành công. Vui lòng đăng nhập để tiếp tục.";
        }
    }

    private void TogglePassword() => showPassword = !showPassword;

    private async Task HandleLogin()
    {
        if (isLoading)
            return;

        errorMessage = null;
        successMessage = null;
        isLoading = true;

        try
        {
            var result = await AuthService.LoginAsync(loginModel);
            if (result == null)
            {
                errorMessage = "Email hoặc mật khẩu không chính xác.";
                return;
            }

            await TokenStorage.SetTokensAsync(result.AccessToken, result.RefreshToken);
            AuthState.SetUser(result);
            NavigateByRole(result.Roles);
        }
        catch (HttpRequestException)
        {
            errorMessage = "Không thể kết nối đến máy chủ. Vui lòng kiểm tra mạng/API.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Đăng nhập thất bại: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    [JSInvokable]
    public async Task OnGoogleLogin(string idToken)
    {
        errorMessage = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            if (string.IsNullOrWhiteSpace(idToken))
            {
                errorMessage = "Google token không hợp lệ.";
                return;
            }

            var response = await Http.PostAsJsonAsync(
                "api/auth/google",
                new GoogleLoginRequest { IdToken = idToken });

            if (!response.IsSuccessStatusCode)
            {
                var err = await response.Content.ReadFromJsonAsync<ApiError>();
                errorMessage = err?.Message
                    ?? "Đăng nhập Google thất bại. Token không hợp lệ hoặc tài khoản bị khóa.";
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<AuthResponse>();
            if (result is null || string.IsNullOrWhiteSpace(result.AccessToken))
            {
                errorMessage = "Phản hồi Google login không hợp lệ.";
                return;
            }

            await TokenStorage.SetTokensAsync(result.AccessToken, result.RefreshToken);
            AuthState.SetUser(result);
            NavigateByRole(result.Roles);
        }
        catch (HttpRequestException)
        {
            errorMessage = "Mất kết nối mạng khi đăng nhập Google.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Google login lỗi: {ex.Message}";
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    [JSInvokable]
    public Task OnGoogleLoginError(string message)
    {
        errorMessage = string.IsNullOrWhiteSpace(message)
            ? "Đăng nhập Google bị hủy hoặc thất bại."
            : message;
        return InvokeAsync(StateHasChanged);
    }

    private void NavigateByRole(List<string> roles)
    {
        if (roles == null || roles.Count == 0)
        {
            Navigation.NavigateTo("/");
            return;
        }

        var role = roles.FirstOrDefault()?.Trim().ToLowerInvariant();
        Navigation.NavigateTo(role switch
        {
            "admin" => "/admin",
            "seller" => "/seller",
            "shipper" => "/shipper",
            "customer" => "/",
            _ => "/"
        });
    }

    public ValueTask DisposeAsync()
    {
        dotNetRef?.Dispose();
        return ValueTask.CompletedTask;
    }

    private sealed class ApiError
    {
        public string? Message { get; set; }
    }
}
