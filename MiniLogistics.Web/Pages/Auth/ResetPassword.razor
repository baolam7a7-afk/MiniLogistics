@page "/reset-password"
@layout AuthLayout
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Đặt lại mật khẩu - MiniLogistics</PageTitle>

<div class="login-page">
    <div class="login-header">
        <h1>Đặt lại mật khẩu</h1>
        <p>Nhập mã và mật khẩu mới.</p>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="auth-alert auth-alert-error">@errorMessage</div>
    }

    @if (done)
    {
        <div class="auth-alert auth-alert-success">Đã đặt lại mật khẩu.</div>
        <button type="button" class="auth-submit" @onclick="GoLogin">Đăng nhập</button>
    }
    else
    {
        <EditForm Model="model" OnValidSubmit="Submit">
            <div class="auth-field">
                <label>Mã đặt lại</label>
                <InputText @bind-Value="model.Token" class="auth-input" />
            </div>
            <div class="auth-field">
                <label>Mật khẩu mới</label>
                <InputText @bind-Value="model.NewPassword" type="password" class="auth-input" />
            </div>
            <div class="auth-field">
                <label>Nhập lại mật khẩu</label>
                <InputText @bind-Value="confirmPassword" type="password" class="auth-input" />
            </div>
            <button type="submit" class="auth-submit" disabled="@isLoading">
                @(isLoading ? "Đang lưu..." : "Lưu mật khẩu")
            </button>
        </EditForm>
    }

    <div class="auth-register">
        <a href="/login">Về đăng nhập</a>
    </div>
</div>

@code {
    private ResetPasswordRequest model = new();
    private string confirmPassword = "";
    private bool isLoading;
    private bool done;
    private string? errorMessage;

    protected override void OnInitialized()
    {
        var query = Navigation.ToAbsoluteUri(Navigation.Uri).Query.TrimStart('?');
        foreach (var part in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var bits = part.Split('=', 2);
            if (bits.Length == 2 && bits[0] == "token")
            {
                model.Token = Uri.UnescapeDataString(bits[1]);
            }
        }
    }

    private async Task Submit()
    {
        errorMessage = null;
        if (model.NewPassword != confirmPassword)
        {
            errorMessage = "Mật khẩu nhập lại chưa khớp.";
            return;
        }

        isLoading = true;
        var ok = await AuthService.ResetPasswordAsync(model);
        isLoading = false;
        if (!ok)
        {
            errorMessage = "Mã không hợp lệ hoặc mật khẩu chưa đạt yêu cầu.";
            return;
        }

        done = true;
    }

    private void GoLogin() => Navigation.NavigateTo("/login");
}
