@page "/checkout"
@layout CustomerLayout

@using Microsoft.AspNetCore.Components
@using MiniLogistics.Web.Models.Address
@using MiniLogistics.Web.Models.Cart
@using MiniLogistics.Web.Models.Order
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using MiniLogistics.Web.Services.Address
@using MiniLogistics.Web.Services.Auth
@using MiniLogistics.Web.Services.Cart
@using MiniLogistics.Web.Services.Order
@using MiniLogistics.Web.Services.Product

@inject CartService CartService
@inject CheckoutSelection CheckoutSelection
@inject AddressService AddressService
@inject OrderService OrderService
@inject HttpClient Http
@inject TokenStorageService TokenStorage
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Thanh toán</PageTitle>

<div class="checkout-page">

    <!-- HEADER -->
    <div class="checkout-header">

        <div>
            <h1>Thanh toán</h1>

            <p>
                Kiểm tra thông tin trước khi đặt hàng.
            </p>
        </div>

        <button class="app-button app-button-secondary" @onclick="GoToCart">
            ← Quay lại giỏ hàng
        </button>

    </div>


    @if (isLoading)
    {
        <div class="checkout-state-card">

            <div class="orders-spinner"></div>

            <p>
                Đang tải thông tin thanh toán...
            </p>

        </div>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="checkout-state-card checkout-error">

            <h3>
                Không thể tải trang thanh toán
            </h3>

            <p>
                @errorMessage
            </p>

            <button class="app-button app-button-primary" @onclick="LoadCheckoutAsync">
                Thử lại
            </button>

        </div>
    }
    else if (cart == null || cart.Items.Count == 0)
    {
        <div class="checkout-state-card">

            <div class="checkout-empty-icon">
                🛒
            </div>

            <h3>
                Giỏ hàng đang trống
            </h3>

            <p>
                Bạn cần có sản phẩm trong giỏ hàng trước khi
                thanh toán.
            </p>

            <button class="app-button app-button-primary" @onclick="GoToProducts">
                Tiếp tục mua sắm
            </button>

        </div>
    }
    else
    {
        <div class="checkout-layout">

            <!-- =========================
                 LEFT
                 ========================= -->

            <div class="checkout-main">


                <!-- 1. ADDRESS -->
                <section class="checkout-card">

                    <div class="checkout-card-header">

                        <div>

                            <h2>
                                1. Địa chỉ giao hàng
                            </h2>

                            <p>
                                Chọn địa chỉ nhận hàng của bạn.
                            </p>

                        </div>

                        <button class="app-button app-button-secondary" @onclick="GoToAddresses">
                            Quản lý địa chỉ
                        </button>

                    </div>


                    @if (addresses.Count == 0)
                    {
                        <div class="checkout-no-address">

                            <p>
                                Bạn chưa có địa chỉ giao hàng.
                            </p>

                            <button class="app-button app-button-primary" @onclick="GoToAddresses">
                                Thêm địa chỉ
                            </button>

                        </div>
                    }
                    else
                    {
                        <div class="checkout-address-list">

                            @foreach (var address in addresses)
                            {
                                <label class="checkout-address-item @(selectedAddressId == address.Id ? "selected" : "")">

                                    <input type="radio" name="shippingAddress" value="@address.Id"
                                           checked="@IsAddressSelected(address.Id)" @onchange="() => SelectAddress(address.Id)" />

                                    <div class="checkout-address-content">

                                        <div class="checkout-address-top">

                                            <strong>
                                                @address.ReceiverName
                                            </strong>

                                            @if (address.IsDefault)
                                            {
                                                <span class="checkout-default-badge">
                                                    Mặc định
                                                </span>
                                            }

                                        </div>

                                        <span>
                                            @address.ReceiverPhone
                                        </span>

                                        <span>
                                            @address.Line1
                                        </span>

                                        @if (!string.IsNullOrWhiteSpace(address.Line2))
                                        {
                                            <span>
                                                @address.Line2
                                            </span>
                                        }

                                        <span>
                                            @BuildAddress(address)
                                        </span>

                                    </div>

                                </label>
                            }

                        </div>
                    }

                </section>


                <!-- 2. PRODUCTS -->
                <section class="checkout-card">

                    <div class="checkout-card-header">

                        <div>

                            <h2>
                                2. Sản phẩm
                            </h2>

                            <p>
                                Sản phẩm bạn đang đặt mua.
                            </p>

                        </div>

                    </div>


                    <div class="checkout-products">

                        @foreach (var item in cart!.Items)
                        {
                            <div class="checkout-product">

                                <div class="checkout-product-icon">
                                    @{
                                        var imageUrl = VariantImages.Resolve(item.VariantName, item.ImageUrl);
                                    }
                                    @if (!string.IsNullOrWhiteSpace(imageUrl))
                                    {
                                        <img src="@imageUrl" alt="@item.ProductName" />
                                    }
                                    else
                                    {
                                        <span>📦</span>
                                    }
                                </div>

                                <div class="checkout-product-info">

                                    <strong>
                                        @item.ProductName
                                    </strong>

                                    <span>
                                        Phân loại: @item.VariantName
                                    </span>

                                    <span>
                                        SKU: @item.Sku
                                    </span>

                                    <span>
                                        Số lượng: @item.Quantity
                                    </span>

                                </div>

                                <div class="checkout-product-price">

                                    <span>
                                        @FormatMoney(item.Price)
                                    </span>

                                    <strong>
                                        @FormatMoney(item.TotalPrice)
                                    </strong>

                                </div>

                            </div>
                        }

                    </div>

                </section>


                <!-- 3. PAYMENT -->
                <section class="checkout-card">

                    <div class="checkout-card-header">

                        <div>

                            <h2>
                                3. Phương thức thanh toán
                            </h2>

                            <p>
                                Chọn phương thức thanh toán.
                            </p>

                        </div>

                    </div>


                    <div class="checkout-payment-list">

                        <label class="checkout-payment-item @(selectedPaymentMethod == "cod" ? "selected" : "")">
                            <input type="radio" name="paymentMethod" value="cod" checked="@(selectedPaymentMethod == "cod")"
                                   @onchange="@(() => selectedPaymentMethod = "cod")" />
                            <div>
                                <strong>Thanh toán khi nhận hàng (COD)</strong>
                                <span>Bạn thanh toán cho shipper khi nhận được hàng.</span>
                            </div>
                        </label>

                        <label class="checkout-payment-item @(selectedPaymentMethod == "qr" ? "selected" : "")">
                            <input type="radio" name="paymentMethod" value="qr" checked="@(selectedPaymentMethod == "qr")"
                                   @onchange="@(() => selectedPaymentMethod = "qr")" />
                            <div>
                                <strong>Thanh toán QR</strong>
                                <span>Quét mã VietQR để thanh toán đơn hàng.</span>
                            </div>
                        </label>

                    </div>

                </section>


                <!-- 4. NOTE -->
                <section class="checkout-card">

                    <div class="checkout-card-header">

                        <div>

                            <h2>
                                4. Ghi chú
                            </h2>

                            <p>
                                Ghi chú cho đơn hàng nếu cần.
                            </p>

                        </div>

                    </div>


                    <textarea class="app-input checkout-note" rows="4" placeholder="Ví dụ: Giao hàng giờ hành chính..."
                              @bind="note"></textarea>

                </section>

            </div>


            <!-- =========================
                 RIGHT
                 ========================= -->

            <aside class="checkout-sidebar">

                <section class="checkout-card checkout-summary">

                    <div class="checkout-card-header">

                        <h2>
                            Đơn hàng
                        </h2>

                    </div>


                    <div class="checkout-summary-row">

                        <span>
                            Sản phẩm
                        </span>

                        <strong>
                            @cart!.Items.Sum(x => x.Quantity)
                        </strong>

                    </div>


                    <div class="checkout-summary-row">

                        <span>
                            Tạm tính
                        </span>

                        <strong>
                            @FormatMoney(cart!.TotalAmount)
                        </strong>

                    </div>


                    <div class="checkout-summary-row">

                        <span>
                            Phí vận chuyển
                        </span>

                        <strong>
                            @FormatMoney(shippingFee)
                        </strong>

                    </div>


                    <div class="checkout-summary-row">
                        <span>Giảm giá</span>
                        <button type="button"
                                class="checkout-summary-action @(VoucherDiscount > 0 ? null : "checkout-summary-action-pick")"
                                @onclick="OpenVoucherPopup">
                            @(VoucherDiscount > 0 ? $"-{FormatMoney(VoucherDiscount)}" : "Chọn voucher")
                        </button>
                    </div>

                    <div class="checkout-summary-divider"></div>


                    <div class="checkout-summary-total">

                        <span>
                            Tổng cộng
                        </span>

                        <strong>
                            @FormatMoney(PayableTotal)
                        </strong>

                    </div>


                    @if (!string.IsNullOrWhiteSpace(submitError))
                    {
                        <div class="checkout-submit-error">
                            @submitError
                        </div>
                    }


                    <button class="app-button app-button-primary checkout-submit-button" disabled="@IsSubmitDisabled"
                            @onclick="PlaceOrderAsync">

                        @if (isSubmitting)
                        {
                            <span>
                                Đang đặt hàng...
                            </span>
                        }
                        else
                        {
                            <span>
                                Đặt hàng
                            </span>
                        }

                    </button>


                    <p class="checkout-secure-text">
                        🔒 Thông tin đơn hàng của bạn được bảo mật.
                    </p>

                </section>

            </aside>

        </div>
    }

</div>

@if (showVoucherPopup)
{
    <div class="address-modal-overlay" @onclick="CloseVoucherPopup">
        <div class="address-modal" @onclick:stopPropagation="true">
            <div class="address-modal-header">
                <div>
                    <h2>Chọn voucher</h2>
                    <p>Tối đa 2 voucher: 1 của admin và 1 của shop.</p>
                </div>
                <button type="button" class="modal-close-button" @onclick="CloseVoucherPopup">×</button>
            </div>
            <div class="voucher-popup-body">
                @if (isLoadingVouchers)
                {
                    <p>Đang tải voucher...</p>
                }
                else
                {
                    <h3 class="voucher-group-title">Voucher admin · @AdminOptions.Count()</h3>
                    @if (!AdminOptions.Any())
                    {
                        <p class="checkout-voucher-empty">Không có voucher admin khả dụng.</p>
                    }
                    else
                    {
                        @foreach (var voucher in AdminOptions)
                        {
                            <label class="voucher-option @(draftAdminId == voucher.Id ? "selected" : null) @(BlockReason(voucher) != null ? "disabled" : null)">
                                <input type="checkbox"
                                       disabled="@(BlockReason(voucher) != null)"
                                       checked="@(draftAdminId == voucher.Id)"
                                       @onchange="() => ToggleDraft(voucher, true)" />
                                <span>
                                    <strong>@(voucher.Name ?? voucher.Code)</strong>
                                    <small>@voucher.Code · @DiscountLabel(voucher)</small>
                                    <small class="voucher-meta">@QuantityLabel(voucher) · @CountdownLabel(voucher)</small>
                                    @if (BlockReason(voucher) is string adminReason)
                                    {
                                        <small class="voucher-block">@adminReason</small>
                                    }
                                </span>
                            </label>
                        }
                    }

                    <h3 class="voucher-group-title">Voucher shop · @SellerOptions.Count()</h3>
                    @if (SelectedShopIds.Count > 1)
                    {
                        <p class="checkout-voucher-empty">Đơn đang có sản phẩm của nhiều shop. Chỉ dùng được voucher admin.</p>
                    }
                    else if (!SellerOptions.Any())
                    {
                        <p class="checkout-voucher-empty">Không có voucher shop cho đơn này.</p>
                    }
                    else
                    {
                        @foreach (var voucher in SellerOptions)
                        {
                            <label class="voucher-option @(draftSellerId == voucher.Id ? "selected" : null) @(BlockReason(voucher) != null ? "disabled" : null)">
                                <input type="checkbox"
                                       disabled="@(BlockReason(voucher) != null)"
                                       checked="@(draftSellerId == voucher.Id)"
                                       @onchange="() => ToggleDraft(voucher, false)" />
                                <span>
                                    <strong>@(voucher.Name ?? voucher.Code)</strong>
                                    <small>@voucher.Code · @DiscountLabel(voucher)</small>
                                    <small class="voucher-meta">@QuantityLabel(voucher) · @CountdownLabel(voucher)</small>
                                    @if (BlockReason(voucher) is string shopReason)
                                    {
                                        <small class="voucher-block">@shopReason</small>
                                    }
                                </span>
                            </label>
                        }
                    }
                }
                <div class="order-modal-actions">
                    <button type="button" class="app-button app-button-secondary" @onclick="CloseVoucherPopup">Hủy</button>
                    <button type="button" class="app-button app-button-primary" @onclick="ConfirmVouchers">Dùng voucher đã chọn</button>
                </div>
            </div>
        </div>
    </div>
}

@code {

    // =============================================================
    // STATE
    // =============================================================

    private CartResponse? cart;

    private List<Address> addresses = new();

    private long selectedAddressId;

    private string selectedPaymentMethod = "cod";

    private string note = string.Empty;
    private bool showVoucherPopup;
    private bool isLoadingVouchers;
    private Timer? voucherClock;
    private DateTime voucherNow = DateTime.UtcNow;
    private List<CheckoutVoucher> voucherOptions = new();
    private long? draftAdminId;
    private long? draftSellerId;
    private CheckoutVoucher? adminVoucher;
    private CheckoutVoucher? sellerVoucher;

    private decimal shippingFee = 0m;

    private bool isLoading;

    private bool isSubmitting;

    private string? errorMessage;

    private string? submitError;



    // =============================================================
    // INITIALIZE
    // =============================================================

    protected override async Task OnInitializedAsync()
    {
        await LoadCheckoutAsync();
    }



    // =============================================================
    // LOAD CHECKOUT
    // =============================================================

    private async Task LoadCheckoutAsync()
    {
        isLoading = true;

        errorMessage = null;

        submitError = null;

        try
        {
            // -----------------------------------------------------
            // LOAD CART
            // -----------------------------------------------------

            cart = await CartService.GetCartAsync();
            if (cart != null && CheckoutSelection.CartItemIds.Count > 0)
            {
                cart.Items = cart.Items
                    .Where(item => CheckoutSelection.CartItemIds.Contains(item.Id))
                    .ToList();
                cart.TotalAmount = cart.Items.Sum(item => item.TotalPrice);
            }

            if (cart == null)
            {
                errorMessage =
                    "Không thể tải giỏ hàng.";

                return;
            }


            // -----------------------------------------------------
            // LOAD ADDRESSES
            // -----------------------------------------------------

            var addressResult =
                await AddressService.GetAddressesAsync();

            addresses =
                addressResult?.ToList()
                ?? new List<Address>();


            // -----------------------------------------------------
            // SELECT DEFAULT ADDRESS
            // -----------------------------------------------------

            var defaultAddress =
                addresses.FirstOrDefault(
                    x => x.IsDefault);

            if (defaultAddress != null)
            {
                selectedAddressId =
                    defaultAddress.Id;
            }
            else
            {
                var firstAddress =
                    addresses.FirstOrDefault();

                if (firstAddress != null)
                {
                    selectedAddressId =
                        firstAddress.Id;
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Có lỗi xảy ra: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }



    // =============================================================
    // ADDRESS SELECTION
    // =============================================================

    private bool IsAddressSelected(long addressId)
    {
        return selectedAddressId == addressId;
    }



    private void SelectAddress(long addressId)
    {
        selectedAddressId = addressId;

        submitError = null;
    }



    // =============================================================
    // PAYMENT
    // =============================================================

    private bool IsCodSelected =>
        selectedPaymentMethod == "COD";



    private void SelectCod(ChangeEventArgs e)
    {
        selectedPaymentMethod = "COD";

        submitError = null;
    }



    // =============================================================
    // PLACE ORDER
    // =============================================================

    private async Task PlaceOrderAsync()
    {
        submitError = null;


        // ---------------------------------------------------------
        // CHECK CART
        // ---------------------------------------------------------

        if (cart == null || cart.Items.Count == 0)
        {
            submitError =
                "Giỏ hàng đang trống.";

            return;
        }


        // ---------------------------------------------------------
        // CHECK ADDRESS
        // ---------------------------------------------------------

        if (selectedAddressId <= 0)
        {
            submitError =
                "Vui lòng chọn địa chỉ giao hàng.";

            return;
        }


        // ---------------------------------------------------------
        // CHECK PAYMENT
        // ---------------------------------------------------------

        if (string.IsNullOrWhiteSpace(
            selectedPaymentMethod))
        {
            submitError =
                "Vui lòng chọn phương thức thanh toán.";

            return;
        }


        // ---------------------------------------------------------
        // PREVENT DOUBLE CLICK
        // ---------------------------------------------------------

        if (isSubmitting)
        {
            return;
        }


        isSubmitting = true;


        try
        {
            // -----------------------------------------------------
            // CREATE ORDER REQUEST
            // -----------------------------------------------------

            var request =
                new CreateOrderRequest
                {
                    ShippingAddressId =
                        selectedAddressId,

                    PaymentMethod =
                        selectedPaymentMethod,

                    Note =
                        note.Trim(),

                    Items =
                        cart.Items
                            .Select(item =>
                                new OrderItemRequest
                                {
                                    VariantId =
                                        item.VariantId,

                                    Quantity =
                                        item.Quantity
                                })
                            .ToList()
                };


            // -----------------------------------------------------
            // CALL ORDER API
            // -----------------------------------------------------

            var order =
                await OrderService.CreateOrderAsync(
                    request);


            // -----------------------------------------------------
            // CREATE ORDER FAILED
            // -----------------------------------------------------

            if (order == null)
            {
                submitError =
                    "Không thể tạo đơn hàng. " +
                    "Vui lòng thử lại.";

                return;
            }


            // -----------------------------------------------------
            // CREATE ORDER SUCCESS
            // -----------------------------------------------------

            foreach (var voucher in new[] { adminVoucher, sellerVoucher })
            {
                if (voucher == null)
                {
                    continue;
                }

                try
                {
                    await OrderService.ApplyVoucherAsync(order.Id, voucher.Code);
                }
                catch (Exception voucherError)
                {
                    submitError = $"{voucherError.Message} Đơn #{order.Id} đã được tạo.";
                    return;
                }
            }

            if (string.Equals(selectedPaymentMethod, "qr", StringComparison.OrdinalIgnoreCase))
            {
                Navigation.NavigateTo($"/orders/{order.Id}/qr-payment");
            }
            else
            {
                Navigation.NavigateTo($"/orders/{order.Id}");
            }        }
        catch (Exception ex)
        {
            submitError =
                $"Không thể đặt hàng: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }



    // =============================================================
    // NAVIGATION
    // =============================================================

    private void GoToCart()
    {
        Navigation.NavigateTo("/cart");
    }



    private void GoToProducts()
    {
        Navigation.NavigateTo("/products");
    }



    private void GoToAddresses()
    {
        Navigation.NavigateTo("/addresses");
    }



    // =============================================================
    // BUILD ADDRESS TEXT
    // =============================================================

    private static string BuildAddress(
        Address address)
    {
        var parts =
            new List<string>();


        if (!string.IsNullOrWhiteSpace(
            address.Ward))
        {
            parts.Add(address.Ward);
        }


        if (!string.IsNullOrWhiteSpace(
            address.District))
        {
            parts.Add(address.District);
        }


        if (!string.IsNullOrWhiteSpace(
            address.Province))
        {
            parts.Add(address.Province);
        }


        return string.Join(", ", parts);
    }



    // =============================================================
    // FORMAT MONEY
    // =============================================================

    private static string FormatMoney(
        decimal value)
    {
        return $"{value:N0} ₫";
    }



    // =============================================================
    // SUBMIT BUTTON STATE
    // =============================================================

    private bool IsSubmitDisabled =>
        isSubmitting
        || cart == null
        || cart.Items.Count == 0
        || selectedAddressId <= 0;

    private decimal PayableTotal =>
        Math.Max(0, (cart?.TotalAmount ?? 0) + shippingFee - VoucherDiscount);

    private decimal VoucherDiscount
    {
        get
        {
            var room = cart?.TotalAmount ?? 0;
            var admin = Estimate(adminVoucher, room);
            room -= admin;
            return admin + Estimate(sellerVoucher, room);
        }
    }

    private List<long> SelectedShopIds =>
        cart?.Items.Select(item => item.ShopId).Distinct().ToList() ?? new();

    private IEnumerable<CheckoutVoucher> AdminOptions =>
        voucherOptions.Where(voucher => voucher.Scope == "platform");

    private IEnumerable<CheckoutVoucher> SellerOptions =>
        SelectedShopIds.Count == 1
            ? voucherOptions.Where(voucher =>
                voucher.Scope == "shop" && voucher.ShopId == SelectedShopIds[0])
            : Enumerable.Empty<CheckoutVoucher>();

    private async Task OpenVoucherPopup()
    {
        showVoucherPopup = true;
        draftAdminId = adminVoucher?.Id;
        draftSellerId = sellerVoucher?.Id;
        StartVoucherClock();
        await LoadVouchersAsync();
    }

    private void CloseVoucherPopup()
    {
        showVoucherPopup = false;
        StopVoucherClock();
    }

    private void ConfirmVouchers()
    {
        adminVoucher = voucherOptions.FirstOrDefault(voucher => voucher.Id == draftAdminId);
        sellerVoucher = voucherOptions.FirstOrDefault(voucher => voucher.Id == draftSellerId);
        if (adminVoucher != null && BlockReason(adminVoucher) != null)
        {
            adminVoucher = null;
        }

        if (sellerVoucher != null && BlockReason(sellerVoucher) != null)
        {
            sellerVoucher = null;
        }

        showVoucherPopup = false;
        StopVoucherClock();
    }

    private void ToggleDraft(CheckoutVoucher voucher, bool admin)
    {
        if (BlockReason(voucher) != null)
        {
            return;
        }

        if (admin)
        {
            draftAdminId = draftAdminId == voucher.Id ? null : voucher.Id;
        }
        else
        {
            draftSellerId = draftSellerId == voucher.Id ? null : voucher.Id;
        }
    }

    private async Task LoadVouchersAsync()
    {
        isLoadingVouchers = true;
        try
        {
            var token = await TokenStorage.GetAccessTokenAsync();
            var shopId = SelectedShopIds.Count == 1 ? SelectedShopIds[0] : (long?)null;
            var mine = await SendAsync<List<OwnedVoucherJson>>(
                HttpMethod.Get, "api/user-vouchers/mine", token);
            var claimable = await SendAsync<List<ClaimableVoucherJson>>(
                HttpMethod.Get,
                shopId.HasValue
                    ? $"api/user-vouchers/claimable?shopId={shopId.Value}"
                    : "api/user-vouchers/claimable",
                token);

            var options = new List<CheckoutVoucher>();
            foreach (var item in mine ?? new())
            {
                if (!string.Equals(item.Status, "available", StringComparison.OrdinalIgnoreCase))
                {
                    continue;
                }

                options.Add(new CheckoutVoucher
                {
                    Id = item.VoucherId,
                    Code = item.Code,
                    Name = item.Name,
                    Scope = item.Scope,
                    ShopId = item.ShopId,
                    DiscountType = item.DiscountType,
                    DiscountValue = item.DiscountValue,
                    MaxDiscount = item.MaxDiscount,
                    MinOrderValue = item.MinOrderValue,
                    UsageLimit = item.UsageLimit,
                    UsedCount = item.UsedCount,
                    EndAt = item.EndAt,
                    ProductIds = item.ProductIds ?? new()
                });
            }

            foreach (var item in claimable ?? new())
            {
                if (options.Any(option => option.Id == item.Id))
                {
                    continue;
                }

                options.Add(new CheckoutVoucher
                {
                    Id = item.Id,
                    Code = item.Code,
                    Name = item.Name,
                    Scope = item.Scope,
                    ShopId = item.ShopId,
                    DiscountType = item.DiscountType,
                    DiscountValue = item.DiscountValue,
                    MaxDiscount = item.MaxDiscount,
                    MinOrderValue = item.MinOrderValue,
                    UsageLimit = item.UsageLimit,
                    UsedCount = item.UsedCount,
                    EndAt = item.EndAt,
                    ProductIds = item.ProductIds ?? new()
                });
            }

            voucherOptions = options;
        }
        catch
        {
            voucherOptions = new();
        }
        finally
        {
            isLoadingVouchers = false;
        }
    }

    private async Task<T?> SendAsync<T>(HttpMethod method, string url, string? token)
    {
        using var request = new HttpRequestMessage(method, url);
        if (!string.IsNullOrWhiteSpace(token))
        {
            request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
        }

        var response = await Http.SendAsync(request);
        if (!response.IsSuccessStatusCode)
        {
            return default;
        }

        return await response.Content.ReadFromJsonAsync<T>();
    }

    private string? BlockReason(CheckoutVoucher voucher)
    {
        var subtotal = cart?.TotalAmount ?? 0;
        if (TimeLeft(voucher) <= TimeSpan.Zero)
        {
            return "Voucher đã hết hạn.";
        }

        if (voucher.UsageLimit is int limit && voucher.UsedCount >= limit)
        {
            return "Voucher đã hết lượt.";
        }

        if (voucher.MinOrderValue.HasValue && subtotal < voucher.MinOrderValue.Value)
        {
            return $"Đơn tối thiểu {FormatMoney(voucher.MinOrderValue.Value)}.";
        }

        if (voucher.Scope == "shop" &&
            voucher.ProductIds.Count > 0 &&
            cart?.Items.Any(item => voucher.ProductIds.Contains(item.ProductId)) != true)
        {
            return "Voucher chỉ giảm một số sản phẩm không có trong đơn.";
        }

        return null;
    }

    private decimal Estimate(CheckoutVoucher? voucher, decimal room)
    {
        if (voucher == null || room <= 0 || cart == null || BlockReason(voucher) != null)
        {
            return 0;
        }

        var basis = cart.TotalAmount;
        if (voucher.Scope == "shop" && voucher.ProductIds.Count > 0)
        {
            basis = cart.Items
                .Where(item => voucher.ProductIds.Contains(item.ProductId))
                .Sum(item => item.TotalPrice);
        }

        var amount = voucher.DiscountType == "percent"
            ? basis * voucher.DiscountValue / 100m
            : voucher.DiscountValue;
        if (voucher.MaxDiscount.HasValue && amount > voucher.MaxDiscount.Value)
        {
            amount = voucher.MaxDiscount.Value;
        }

        if (amount > basis)
        {
            amount = basis;
        }

        if (amount > room)
        {
            amount = room;
        }

        return amount < 0 ? 0 : amount;
    }

    private static string QuantityLabel(CheckoutVoucher voucher)
    {
        if (voucher.UsageLimit is not int limit)
        {
            return "Không giới hạn lượt";
        }

        var left = Math.Max(0, limit - voucher.UsedCount);
        return $"Còn {left} lượt";
    }

    private string CountdownLabel(CheckoutVoucher voucher)
    {
        var left = TimeLeft(voucher);
        if (left <= TimeSpan.Zero)
        {
            return "Hết hạn";
        }

        if (left.TotalDays >= 1)
        {
            return $"Còn {(int)left.TotalDays} ngày {left.Hours:00}:{left.Minutes:00}:{left.Seconds:00}";
        }

        return $"Còn {left.Hours:00}:{left.Minutes:00}:{left.Seconds:00}";
    }

    private TimeSpan TimeLeft(CheckoutVoucher voucher)
    {
        var end = voucher.EndAt.Kind switch
        {
            DateTimeKind.Local => voucher.EndAt.ToUniversalTime(),
            DateTimeKind.Utc => voucher.EndAt,
            _ => DateTime.SpecifyKind(voucher.EndAt, DateTimeKind.Utc)
        };
        return end - voucherNow;
    }

    private void StartVoucherClock()
    {
        voucherNow = DateTime.UtcNow;
        voucherClock ??= new Timer(_ =>
        {
            _ = InvokeAsync(() =>
            {
                voucherNow = DateTime.UtcNow;
                StateHasChanged();
            });
        }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private void StopVoucherClock()
    {
        voucherClock?.Dispose();
        voucherClock = null;
    }

    public void Dispose() => StopVoucherClock();

    private static string DiscountLabel(CheckoutVoucher voucher) =>
        voucher.DiscountType == "percent"
            ? $"Giảm {voucher.DiscountValue:0.#}%"
            : $"Giảm {voucher.DiscountValue:N0} ₫";

