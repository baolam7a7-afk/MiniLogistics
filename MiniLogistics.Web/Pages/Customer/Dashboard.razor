@page "/dashboard"
@layout CustomerLayout

@using MiniLogistics.Web.Models.Order
@using MiniLogistics.Web.Models.Cart
@using MiniLogistics.Web.Services.Order
@using MiniLogistics.Web.Services.Cart

@inject OrderService OrderService
@inject CartService CartService
@inject NavigationManager Navigation

<PageTitle>Customer Dashboard - MiniLogistics</PageTitle>

<div class="customer-dashboard">

    <!-- PAGE HEADER -->
    <div class="customer-page-header">

        <div>

            <h1 class="customer-page-title">
                Dashboard
            </h1>

            <p class="customer-page-description">
                Chào mừng bạn quay lại MiniLogistics.
                Đây là tổng quan tài khoản của bạn.
            </p>

        </div>

    </div>


    <!-- WELCOME CARD -->
    <div class="customer-welcome-card">

        <div>

            <div class="customer-welcome-label">
                WELCOME BACK
            </div>

            <h2>
                Chào mừng bạn đến với MiniLogistics 👋
            </h2>

            <p>
                Theo dõi đơn hàng, quản lý giỏ hàng,
                địa chỉ và tài khoản của bạn tại đây.
            </p>

        </div>

        <div class="customer-welcome-icon">
            🚚
        </div>

    </div>


    @if (isLoading)
    {
        <!-- LOADING -->
        <div class="customer-empty-state">

            <div class="customer-empty-icon">
                ⏳
            </div>

            <h3>
                Đang tải dữ liệu...
            </h3>

            <p>
                Vui lòng chờ trong giây lát.
            </p>

        </div>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <!-- ERROR -->
        <div class="customer-empty-state">

            <div class="customer-empty-icon">
                ⚠️
            </div>

            <h3>
                Không thể tải Dashboard
            </h3>

            <p>
                @errorMessage
            </p>

            <button class="app-button app-button-primary" @onclick="LoadDashboardAsync">
                Thử lại
            </button>

        </div>
    }
    else
    {
        <!-- STATISTICS -->
        <div class="customer-stat-grid">

            <!-- TOTAL ORDERS -->
            <div class="customer-stat-card">

                <div class="customer-stat-icon">
                    📦
                </div>

                <div class="customer-stat-content">

                    <div class="customer-stat-label">
                        Tổng đơn hàng
                    </div>

                    <div class="customer-stat-value">
                        @totalOrders
                    </div>

                </div>

            </div>


            <!-- SHIPPING -->
            <div class="customer-stat-card">

                <div class="customer-stat-icon">
                    🚚
                </div>

                <div class="customer-stat-content">

                    <div class="customer-stat-label">
                        Đang giao
                    </div>

                    <div class="customer-stat-value">
                        @shippingOrders
                    </div>

                </div>

            </div>


            <!-- CART -->
            <div class="customer-stat-card">

                <div class="customer-stat-icon">
                    🛒
                </div>

                <div class="customer-stat-content">

                    <div class="customer-stat-label">
                        Giỏ hàng
                    </div>

                    <div class="customer-stat-value">
                        @cartItemCount
                    </div>

                </div>

            </div>


            <!-- PENDING -->
            <div class="customer-stat-card">

                <div class="customer-stat-icon">
                    ⏳
                </div>

                <div class="customer-stat-content">

                    <div class="customer-stat-label">
                        Chờ xử lý
                    </div>

                    <div class="customer-stat-value">
                        @pendingOrders
                    </div>

                </div>

            </div>

        </div>


        <!-- QUICK ACTIONS -->
        <div class="customer-section">

            <div class="customer-section-header">

                <div>

                    <h2>
                        Quick Actions
                    </h2>

                    <p>
                        Các chức năng thường sử dụng
                    </p>

                </div>

            </div>


            <div class="customer-action-grid">

                <a href="/products" class="customer-action-card">

                    <div class="customer-action-icon">
                        📦
                    </div>

                    <div>

                        <h3>
                            Browse Products
                        </h3>

                        <p>
                            Khám phá sản phẩm
                        </p>

                    </div>

                </a>


                <a href="/cart" class="customer-action-card">

                    <div class="customer-action-icon">
                        🛒
                    </div>

                    <div>

                        <h3>
                            My Cart
                        </h3>

                        <p>
                            @cartItemCount sản phẩm trong giỏ
                        </p>

                    </div>

                </a>


                <a href="/orders" class="customer-action-card">

                    <div class="customer-action-icon">
                        📋
                    </div>

                    <div>

                        <h3>
                            My Orders
                        </h3>

                        <p>
                            @totalOrders đơn hàng
                        </p>

                    </div>

                </a>


                <a href="/addresses" class="customer-action-card">

                    <div class="customer-action-icon">
                        📍
                    </div>

                    <div>

                        <h3>
                            Addresses
                        </h3>

                        <p>
                            Quản lý địa chỉ
                        </p>

                    </div>

                </a>

            </div>

        </div>


        <!-- RECENT ORDERS -->
        <div class="customer-section">

            <div class="customer-section-header">

                <div>

                    <h2>
                        Recent Orders
                    </h2>

                    <p>
                        Các đơn hàng gần đây của bạn
                    </p>

                </div>

                <a href="/orders" class="customer-view-all">
                    Xem tất cả →
                </a>

            </div>


            @if (recentOrders.Count == 0)
            {
                <div class="customer-empty-state">

                    <div class="customer-empty-icon">
                        📦
                    </div>

                    <h3>
                        Chưa có đơn hàng
                    </h3>

                    <p>
                        Khi bạn đặt hàng, các đơn hàng gần đây
                        sẽ xuất hiện tại đây.
                    </p>

                    <a href="/products" class="app-button app-button-primary">
                        Khám phá sản phẩm
                    </a>

                </div>
            }
            else
            {
                <div class="customer-recent-orders">

                    @foreach (var order in recentOrders)
                    {
                        <div class="customer-recent-order-card">

                            <div class="customer-recent-order-main">

                                <div class="customer-recent-order-icon">
                                    📦
                                </div>

                                <div class="customer-recent-order-info">

                                    <strong>
                                        @order.OrderCode
                                    </strong>

                                    <span>
                                        Đơn hàng của bạn
                                    </span>

                                </div>

                            </div>


                            <div class="customer-recent-order-status">

                                <span class="order-status @GetStatusClass(order.Status)">
                                    @GetStatusText(order.Status)
                                </span>

                            </div>


                            <div class="customer-recent-order-total">

                                <strong>
                                    @FormatCurrency(order.Total)
                                </strong>

                                <button class="app-button app-button-secondary app-button-small"
                                        @onclick="() => ViewOrder(order.Id)">
                                    Chi tiết
                                </button>

                            </div>

                        </div>
                    }

                </div>
            }

        </div>

    }

</div>


@code {

    private List<Order> recentOrders = new();

    private int totalOrders;

    private int shippingOrders;

    private int pendingOrders;

    private int cartItemCount;

    private bool isLoading;

    private string? errorMessage;


    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardAsync();
    }


    private async Task LoadDashboardAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            // ============================================
            // LOAD ORDERS
            // ============================================

            var orderResult =
    await OrderService.GetMyOrdersAsync(
        string.Empty,
        string.Empty,
        1,
        100);

            if (orderResult != null)
            {
                totalOrders = orderResult.TotalItems;

                recentOrders =
    orderResult.Items?
        .Take(5)
        .ToList()
    ?? new List<Order>();

                shippingOrders =
                    recentOrders.Count(
                        x => string.Equals(
                            x.Status,
                            "shipped",
                            StringComparison.OrdinalIgnoreCase));

                pendingOrders =
                    recentOrders.Count(
                        x =>
                            string.Equals(
                                x.Status,
                                "pending",
                                StringComparison.OrdinalIgnoreCase)
                            ||
                            string.Equals(
                                x.Status,
                                "confirmed",
                                StringComparison.OrdinalIgnoreCase)
                            ||
                            string.Equals(
                                x.Status,
                                "processing",
                                StringComparison.OrdinalIgnoreCase));
            }
            else
            {
                recentOrders = new();
                totalOrders = 0;
                shippingOrders = 0;
                pendingOrders = 0;
            }


            // ============================================
            // LOAD CART
            // ============================================

            var cart =
                await CartService.GetCartAsync();

            cartItemCount =
                cart?.Items?.Sum(x => x.Quantity) ?? 0;
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Có lỗi khi tải dữ liệu Dashboard: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }


    private void ViewOrder(long orderId)
    {
        Navigation.NavigateTo(
            $"/orders/{orderId}");
    }


    private static string GetStatusText(string? status)
    {
        return status?.ToLowerInvariant() switch
        {
            "pending" => "Chờ xử lý",
            "confirmed" => "Đã xác nhận",
            "processing" => "Đang xử lý",
            "shipped" => "Đang giao",
            "delivered" => "Đã giao",
            "completed" => "Hoàn thành",
            "cancelled" => "Đã hủy",
            _ => status ?? "Không xác định"
        };
    }


    private static string GetStatusClass(string? status)
    {
        return status?.ToLowerInvariant() switch
        {
            "pending" => "status-pending",
            "confirmed" => "status-confirmed",
            "processing" => "status-processing",
            "shipped" => "status-shipped",
            "delivered" => "status-delivered",
            "completed" => "status-completed",
            "cancelled" => "status-cancelled",
            _ => "status-default"
        };
    }


    private static string FormatCurrency(decimal amount)
    {
        return string.Format(
            new System.Globalization.CultureInfo("vi-VN"),
            "{0:N0} ₫",
            amount);
    }
}