@page "/"

@using Microsoft.AspNetCore.Components.Web
@using MiniLogistics.Web.Components
@using MiniLogistics.Web.Models.Product
@using MiniLogistics.Web.Services.Product

@layout CustomerLayout

@inject ProductService ProductService
@inject NavigationManager Navigation

<PageTitle>MiniLogistics — Mua sắm</PageTitle>

<div class="store-home">

    <section class="store-hero">
        <div class="store-hero-inner">
            <div class="store-hero-copy">
                <p class="store-hero-eyebrow">MiniLogistics</p>
                <h1 class="store-hero-title">Mua sắm dễ dàng, giao hàng tin cậy</h1>
                <p class="store-hero-subtitle">
                    Khám phá sản phẩm từ các shop trên nền tảng — thanh toán COD, theo dõi đơn hàng mọi lúc.
                </p>

                <form class="store-hero-search"
                      @onsubmit="SearchFromHero"
                      @onsubmit:preventDefault>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <circle cx="11" cy="11" r="7" />
                        <path d="M20 20l-3.5-3.5" stroke-linecap="round" />
                    </svg>
                    <input type="search"
                           placeholder="Bạn đang tìm gì hôm nay?"
                           @bind="searchText"
                           @bind:event="oninput"
                           @onkeydown="HandleSearchKeyDown"
                           aria-label="Tìm kiếm sản phẩm" />
                    <button type="submit" class="app-button app-button-primary">
                        Tìm kiếm
                    </button>
                </form>

                <div class="store-hero-chips">
                    <button type="button" class="store-chip" @onclick='() => QuickFilter("")'>Tất cả</button>
                    <button type="button" class="store-chip" @onclick='() => QuickFilter("active")'>Đang bán</button>
                    <a class="store-chip" href="/products">Xem toàn bộ →</a>
                </div>
            </div>

            <div class="store-hero-panel" aria-hidden="true">
                <div class="store-hero-stat">
                    <span class="store-hero-stat-value">@totalItems+</span>
                    <span class="store-hero-stat-label">Sản phẩm</span>
                </div>
                <div class="store-hero-stat">
                    <span class="store-hero-stat-value">COD</span>
                    <span class="store-hero-stat-label">Thanh toán khi nhận</span>
                </div>
                <div class="store-hero-stat">
                    <span class="store-hero-stat-value">24/7</span>
                    <span class="store-hero-stat-label">Theo dõi đơn</span>
                </div>
            </div>
        </div>
    </section>

    <div class="store-home-body">

        <div class="store-section-head">
            <div>
                <h2 class="store-section-title">Sản phẩm nổi bật</h2>
                <p class="store-section-desc">Chọn sản phẩm và thêm vào giỏ chỉ với vài bước</p>
            </div>

            <div class="store-section-filters">
                <select class="app-input store-filter-select" @bind="selectedStatus">
                    <option value="">Trạng thái</option>
                    <option value="active">Đang bán</option>
                    <option value="inactive">Ngừng bán</option>
                </select>
                <button type="button" class="app-button app-button-secondary" @onclick="SearchProducts">
                    Lọc
                </button>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="app-alert app-alert-error">@errorMessage</div>
        }

        @if (isLoading)
        {
            <div class="store-product-skeleton-grid">
                @for (var i = 0; i < 8; i++)
                {
                    <div class="store-skeleton-card"></div>
                }
            </div>
        }
        else if (products.Count == 0)
        {
            <div class="app-empty store-empty">
                <div class="app-empty-icon">📦</div>
                <h3>Không tìm thấy sản phẩm</h3>
                <p>Thử từ khóa khác hoặc xem toàn bộ danh mục.</p>
                <a href="/products" class="app-button app-button-primary">Đến trang sản phẩm</a>
            </div>
        }
        else
        {
            <div class="product-grid store-product-grid">
                @foreach (var product in products)
                {
                    <ProductCard Product="product" @key="product.Id" />
                }
            </div>

            @if (totalPages > 1)
            {
                <div class="orders-pagination store-pagination">
                    <button type="button"
                            class="app-button app-button-secondary"
                            disabled="@(currentPage <= 1)"
                            @onclick="PreviousPage">
                        Trước
                    </button>
                    <span class="orders-page-number">Trang @currentPage / @totalPages</span>
                    <button type="button"
                            class="app-button app-button-secondary"
                            disabled="@(currentPage >= totalPages)"
                            @onclick="NextPage">
                        Sau
                    </button>
                </div>
            }
        }
    </div>
</div>

@code {
    private string searchText = string.Empty;
    private string selectedStatus = "active";
    private List<ProductItem> products = new();
    private int currentPage = 1;
    private int pageSize = 12;
    private int totalItems;
    private int totalPages;
    private bool isLoading;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadProducts();
    }

    private async Task LoadProducts()
    {
        if (isLoading)
            return;

        isLoading = true;
        errorMessage = null;

        try
        {
            var result = await ProductService.GetProductsAsync(
                searchText,
                null,
                null,
                string.IsNullOrWhiteSpace(selectedStatus) ? null : selectedStatus,
                currentPage,
                pageSize);

            if (result == null)
            {
                products = new();
                totalItems = 0;
                totalPages = 0;
                return;
            }

            products = result.Items?.ToList() ?? new List<ProductItem>();
            totalItems = result.TotalItems;
            totalPages = result.TotalPages;
        }
        catch (HttpRequestException)
        {
            errorMessage = "Không thể kết nối đến API. Vui lòng kiểm tra Backend.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Không thể tải sản phẩm: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SearchProducts()
    {
        currentPage = 1;
        await LoadProducts();
    }

    private async Task SearchFromHero()
    {
        if (!string.IsNullOrWhiteSpace(searchText))
        {
            Navigation.NavigateTo($"/products?q={Uri.EscapeDataString(searchText.Trim())}");
            return;
        }

        await SearchProducts();
    }

    private async Task QuickFilter(string status)
    {
        selectedStatus = status;
        currentPage = 1;
        await LoadProducts();
    }

    private async Task HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SearchFromHero();
    }

    private async Task PreviousPage()
    {
        if (currentPage <= 1)
            return;
        currentPage--;
        await LoadProducts();
    }

    private async Task NextPage()
    {
        if (currentPage >= totalPages)
            return;
        currentPage++;
        await LoadProducts();
    }
}
