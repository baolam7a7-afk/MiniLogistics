@page "/vouchers"
@layout CustomerLayout

@using System.Net.Http.Json
@using MiniLogistics.Web.Services.Auth

@inject HttpClient Http
@inject TokenStorageService TokenStorage
@inject NavigationManager Navigation

<PageTitle>Voucher của tôi - MiniLogistics</PageTitle>

<div class="customer-products">
    <div class="customer-page-header">
        <h1 class="customer-page-title">Voucher</h1>
        <p class="customer-page-description">Nhận và quản lý voucher Admin / Seller</p>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="app-alert app-alert-error">@errorMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="app-alert app-alert-success">@successMessage</div>
    }

    <div class="store-section-head">
        <h2 class="store-section-title">Có thể nhận</h2>
    </div>

    @if (isLoading)
    {
        <p class="text-muted">Đang tải...</p>
    }
    else if (claimable.Count == 0)
    {
        <p class="text-muted">Không còn voucher mới để nhận.</p>
    }
    else
    {
        <div class="product-grid store-product-grid">
            @foreach (var v in claimable)
            {
                <article class="product-card store-product-card" style="cursor:default">
                    <div class="product-card-body">
                        <span class="product-category-badge">@(v.Scope == "platform" ? "Admin" : "Seller")</span>
                        <h3 class="product-name">@(v.Name ?? v.Code)</h3>
                        <p class="product-description">@v.Code · @FormatDiscount(v)</p>
                        <p class="text-muted" style="font-size:12px">
                            HSD: @v.EndAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                            @if (v.MinOrderValue.HasValue)
                            {
                                <text> · Đơn tối thiểu @v.MinOrderValue.Value.ToString("N0") ₫</text>
                            }
                        </p>
                        <button class="app-button app-button-primary app-button-sm"
                                @onclick="() => Claim(v.Id)">
                            Nhận voucher
                        </button>
                    </div>
                </article>
            }
        </div>
    }

    <div class="store-section-head" style="margin-top:36px">
        <h2 class="store-section-title">Đã nhận</h2>
    </div>

    @if (mine.Count == 0)
    {
        <p class="text-muted">Bạn chưa có voucher nào.</p>
    }
    else
    {
        <div class="product-grid store-product-grid">
            @foreach (var v in mine)
            {
                <article class="product-card store-product-card" style="cursor:default">
                    <div class="product-card-body">
                        <span class="product-status">@v.Status</span>
                        <h3 class="product-name">@(v.Name ?? v.Code)</h3>
                        <p class="product-description">@v.Code · @FormatOwnedDiscount(v)</p>
                        <p class="text-muted" style="font-size:12px">
                            Nhận: @v.ClaimedAt.ToLocalTime().ToString("dd/MM/yyyy")
                        </p>
                    </div>
                </article>
            }
        </div>
    }
</div>

@code {
    private List<ClaimableVoucher> claimable = new();
    private List<OwnedVoucher> mine = new();
    private bool isLoading = true;
    private string? errorMessage;
    private string? successMessage;

    protected override async Task OnInitializedAsync()
    {
        var token = await TokenStorage.GetAccessTokenAsync();
        if (string.IsNullOrWhiteSpace(token))
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await Reload();
    }

    private async Task Reload()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            using var req1 = AuthGet("api/user-vouchers/claimable");
            using var req2 = AuthGet("api/user-vouchers/mine");
            var r1 = await Http.SendAsync(req1);
            var r2 = await Http.SendAsync(req2);

            if (r1.IsSuccessStatusCode)
                claimable = await r1.Content.ReadFromJsonAsync<List<ClaimableVoucher>>() ?? new();
            if (r2.IsSuccessStatusCode)
                mine = await r2.Content.ReadFromJsonAsync<List<OwnedVoucher>>() ?? new();
        }
        catch
        {
            errorMessage = "Không tải được danh sách voucher.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task Claim(long voucherId)
    {
        successMessage = null;
        errorMessage = null;
        try
        {
            using var req = await AuthPost($"api/user-vouchers/{voucherId}/claim");
            var res = await Http.SendAsync(req);
            if (!res.IsSuccessStatusCode)
            {
                errorMessage = "Không thể nhận voucher (đã nhận / hết hạn / hết lượt).";
                return;
            }

            successMessage = "Đã nhận voucher thành công.";
            await Reload();
        }
        catch
        {
            errorMessage = "Lỗi mạng khi nhận voucher.";
        }
    }

    private HttpRequestMessage AuthGet(string url)
    {
        var req = new HttpRequestMessage(HttpMethod.Get, url);
        var token = TokenStorage.GetAccessTokenAsync().GetAwaiter().GetResult();
        if (!string.IsNullOrWhiteSpace(token))
            req.Headers.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
        return req;
    }

    private async Task<HttpRequestMessage> AuthPost(string url)
    {
        var req = new HttpRequestMessage(HttpMethod.Post, url);
        var token = await TokenStorage.GetAccessTokenAsync();
        if (!string.IsNullOrWhiteSpace(token))
            req.Headers.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
        return req;
    }

    private static string FormatDiscount(ClaimableVoucher v) =>
        v.DiscountType == "percent"
            ? $"Giảm {v.DiscountValue:0.#}%"
            : $"Giảm {v.DiscountValue:N0} ₫";

    private static string FormatOwnedDiscount(OwnedVoucher v) =>
        v.DiscountType == "percent"
            ? $"Giảm {v.DiscountValue:0.#}%"
            : $"Giảm {v.DiscountValue:N0} ₫";

    private sealed class ClaimableVoucher
    {
        public long Id { get; set; }
        public string Code { get; set; } = "";
        public string? Name { get; set; }
        public string Scope { get; set; } = "";
        public string DiscountType { get; set; } = "";
        public decimal DiscountValue { get; set; }
        public decimal? MinOrderValue { get; set; }
        public DateTime EndAt { get; set; }
    }

    private sealed class OwnedVoucher
    {
        public long Id { get; set; }
        public long VoucherId { get; set; }
        public string Code { get; set; } = "";
        public string? Name { get; set; }
        public string DiscountType { get; set; } = "";
        public decimal DiscountValue { get; set; }
        public string Status { get; set; } = "";
        public DateTime ClaimedAt { get; set; }
    }
}
