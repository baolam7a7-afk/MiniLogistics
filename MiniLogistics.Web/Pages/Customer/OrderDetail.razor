@page "/orders/{Id:long}"
@layout CustomerLayout

@using MiniLogistics.Web.Components
@using MiniLogistics.Web.Models.Order
@using MiniLogistics.Web.Models.Review
@using MiniLogistics.Web.Services.Order
@using MiniLogistics.Web.Services.Product
@using MiniLogistics.Web.Services.Review

@inject OrderService OrderService
@inject ReviewService ReviewService
@inject NavigationManager Navigation

<PageTitle>Chi tiết đơn hàng</PageTitle>

<div class="order-detail-page">

    <!-- HEADER -->

    <div class="order-detail-header">

        <div>
            <button class="app-button app-button-secondary order-back-button"
                    @onclick="GoBack">
                ← Quay lại đơn hàng
            </button>

            <h1>Chi tiết đơn hàng</h1>

            @if (order != null)
            {
                <p>
                    Mã đơn:
                    <strong>@order.OrderCode</strong>
                </p>
            }
        </div>

        @if (order != null)
        {
            <div class="order-detail-status @GetStatusClass(order.Status)">
                @GetStatusText(order.Status)
            </div>
        }

    </div>

    @if (isLoading)
    {
        <div class="order-detail-state">
            <div class="orders-spinner"></div>
            <p>Đang tải thông tin đơn hàng...</p>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="order-detail-state order-detail-error">

            <h3>Không thể tải đơn hàng</h3>

            <p>@errorMessage</p>

            <button class="app-button app-button-primary"
                    @onclick="LoadOrderAsync">
                Thử lại
            </button>

        </div>
    }
    else if (order == null)
    {
        <div class="order-detail-state">

            <div class="order-detail-empty-icon">
                📦
            </div>

            <h3>Không tìm thấy đơn hàng</h3>

            <p>
                Đơn hàng không tồn tại hoặc bạn không có quyền xem đơn hàng này.
            </p>

            <button class="app-button app-button-primary"
                    @onclick="GoBack">
                Quay lại đơn hàng
            </button>

        </div>
    }
    else
    {
        <section class="order-detail-card" style="margin-bottom:20px;padding:16px 18px">
            <h2 style="margin:0 0 4px">Tiến trình đơn hàng</h2>
            <OrderFlow Status="@order.Status" CancelReason="@order.CancelReason" />
            @if (string.Equals(order.Status, "awaiting_receipt", StringComparison.OrdinalIgnoreCase))
            {
                <p>Đơn hàng đang chờ bạn xác nhận đã nhận hàng.</p>
            }
        </section>

        <!-- ORDER INFORMATION -->

        <div class="order-detail-grid">

            <!-- LEFT -->

            <div class="order-detail-main">

                <!-- GENERAL INFO -->

                <section class="order-detail-card">

                    <div class="order-detail-card-title">
                        <h2>Thông tin đơn hàng</h2>
                    </div>

                    <div class="order-detail-info-grid">

                        <div>
                            <span>Mã đơn hàng</span>
                            <strong>@order.OrderCode</strong>
                        </div>

                        <div>
                            <span>Ngày đặt</span>
                            <strong>
                                @order.PlacedAt.ToLocalTime()
                                    .ToString("dd/MM/yyyy HH:mm")
                            </strong>
                        </div>

                        <div>
                            <span>Phương thức thanh toán</span>
                            <strong>
                                @GetPaymentMethodText(order.PaymentMethod)
                            </strong>
                        </div>

                        <div>
                            <span>Trạng thái</span>
                            <strong>
                                @GetStatusText(order.Status)
                            </strong>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(order.ShippingAddressText))
                        {
                            <div>
                                <span>Địa chỉ giao</span>
                                <strong>@order.ShippingAddressText</strong>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(order.ShopName))
                        {
                            <div>
                                <span>Cửa hàng</span>
                                <strong>@order.ShopName</strong>
                            </div>
                        }

                    </div>

                </section>

                <!-- PRODUCTS -->

                <section class="order-detail-card">

                    <div class="order-detail-card-title">

                        <h2>Sản phẩm</h2>

                        <span>
                            @order.Items.Sum(x => x.Quantity) sản phẩm
                        </span>

                    </div>

                    <div class="order-detail-items">

                        @foreach (var item in order.Items)
                        {
                            <div class="order-detail-item">

                                <div class="order-detail-product-icon">
                                    <img src="@VariantImages.Resolve(item.VariantName, item.ImageUrl)" alt="@item.ProductName" />
                                </div>

                                <div class="order-detail-product-info">

                                    <strong>
                                        @item.ProductName
                                    </strong>

                                    <span>
                                        Phân loại:
                                        @item.VariantName
                                    </span>

                                    <span>
                                        Số lượng:
                                        @item.Quantity
                                    </span>
                                    @if (string.Equals(order.Status, "delivered", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <div class="order-item-review">
                                            <div class="order-review-product">
                                                <img src="@VariantImages.Resolve(item.VariantName, item.ImageUrl)" alt="@item.ProductName" />
                                                <div>
                                                    <strong>@item.ProductName</strong>
                                                    <span>@(string.IsNullOrWhiteSpace(item.VariantName) ? "Sản phẩm này" : item.VariantName)</span>
                                                </div>
                                            </div>
                                            @if (editingItemId == item.Id)
                                            {
                                                <div style="display:flex;gap:6px;flex-wrap:wrap;margin-top:8px">
                                                    @for (var star = 1; star <= 5; star++)
                                                    {
                                                        var value = star;
                                                        <button type="button" class="app-button @(draftRating == value ? "app-button-primary" : "app-button-secondary")" @onclick="() => draftRating = value">@value sao</button>
                                                    }
                                                </div>
                                                <textarea @bind="draftContent" maxlength="1000" placeholder="Nhận xét (không bắt buộc)" style="width:100%;margin-top:8px"></textarea>
                                                <button type="button" class="app-button app-button-primary" disabled="@isSavingReview" @onclick="() => SaveReview(item)">
                                                    @(FindReview(item.Id) == null ? "Gửi đánh giá" : "Lưu đánh giá")
                                                </button>
                                            }
                                            else if (FindReview(item.Id) is ReviewResponse existing)
                                            {
                                                <p>@Stars(existing.Rating)</p>
                                                <p>@(string.IsNullOrWhiteSpace(existing.Content) ? "Không có nhận xét." : existing.Content)</p>
                                                <button type="button" class="app-button app-button-secondary" @onclick="() => BeginEdit(existing)">Đánh giá lại</button>
                                            }
                                            else
                                            {
                                                <button type="button" class="app-button app-button-secondary" @onclick="() => BeginNew(item.Id)">Đánh giá sản phẩm</button>
                                            }
                                        </div>
                                    }

                                </div>

                                <div class="order-detail-product-price">

                                    <span>
                                        @FormatMoney(item.UnitPrice)
                                    </span>

                                    <strong>
                                        @FormatMoney(item.LineTotal)
                                    </strong>

                                </div>

                            </div>
                        }

                    </div>

                </section>

                <!-- NOTE -->

                @if (!string.IsNullOrWhiteSpace(order.Note))
                {
                    <section class="order-detail-card">

                        <div class="order-detail-card-title">
                            <h2>Ghi chú</h2>
                        </div>

                        <div class="order-detail-note">
                            @order.Note
                        </div>

                    </section>
                }

                <!-- STATUS HISTORY -->

                <section class="order-detail-card">

                    <div class="order-detail-card-title">
                        <h2>Lịch sử đơn hàng</h2>
                    </div>

                    @if (order.StatusLogs == null ||
                         order.StatusLogs.Count == 0)
                    {
                        <div class="order-history-empty">
                            Chưa có lịch sử trạng thái.
                        </div>
                    }
                    else
                    {
                        <div class="order-history">

                            @foreach (var log in order.StatusLogs
                                .OrderByDescending(x => x.CreatedAt))
                            {
                                <div class="order-history-item">

                                    <div class="order-history-dot">
                                    </div>

                                    <div class="order-history-content">

                                        <div class="order-history-top">

                                            <strong>
                                                @GetStatusText(log.ToStatus)
                                            </strong>

                                            <span>
                                                @log.CreatedAt.ToLocalTime()
                                                    .ToString("dd/MM/yyyy HH:mm")
                                            </span>

                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(log.Message))
                                        {
                                            <p>
                                                @log.Message
                                            </p>
                                        }

                                    </div>

                                </div>
                            }

                        </div>
                    }

                </section>

            </div>

            <!-- RIGHT -->

            <aside class="order-detail-sidebar">

                <!-- TOTAL -->

                <section class="order-detail-card order-summary-card">

                    <div class="order-detail-card-title">
                        <h2>Thanh toán</h2>
                    </div>

                    <div class="order-summary-row">
                        <span>Tạm tính</span>
                        <strong>
                            @FormatMoney(order.Subtotal)
                        </strong>
                    </div>

                    <div class="order-summary-row">
                        <span>Phí vận chuyển</span>
                        <strong>
                            @FormatMoney(order.ShippingFee)
                        </strong>
                    </div>

                    <div class="order-summary-row">
                        <span>Giảm giá</span>
                        <strong>
                            @FormatMoney(order.DiscountTotal)
                        </strong>
                    </div>

                    <div class="order-summary-divider"></div>

                    <div class="order-summary-total">
                        <span>Tổng cộng</span>
                        <strong>
                            @FormatMoney(order.Total)
                        </strong>
                    </div>

                    <div class="order-payment-method">

                        <span>Thanh toán</span>

                        <strong>
                            @GetPaymentMethodText(order.PaymentMethod)
                        </strong>

                    </div>

                </section>

                <!-- ACTIONS -->

                <section class="order-detail-card">

                    <div class="order-detail-card-title">
                        <h2>Thao tác</h2>
                    </div>

                    <div class="order-detail-actions">

                        @if (CanConfirmReceipt(order.Status))
                        {
                            <button class="app-button app-button-primary"
                                    disabled="@isConfirming"
                                    @onclick="OpenReceipt">
                                Đã nhận được hàng
                            </button>
                        }

                        @if (CanCancel(order.Status))
                        {
                            <button class="app-button app-button-danger"
                                    disabled="@isCancelling"
                                    @onclick="CancelOrderAsync">

                                @if (isCancelling)
                                {
                                    <span>Đang hủy...</span>
                                }
                                else
                                {
                                    <span>Hủy đơn hàng</span>
                                }

                            </button>
                        }

                        <button class="app-button app-button-secondary"
                                @onclick="GoToOrders">
                            Danh sách đơn hàng
                        </button>

                        <button class="app-button app-button-primary"
                                @onclick="GoToProducts">
                            Tiếp tục mua sắm
                        </button>

                    </div>

                </section>

            </aside>

        </div>
    }

</div>

@if (showReceipt)
{
    <div class="order-modal-backdrop">
        <div class="order-modal">
            <h3>Xác nhận nhận hàng</h3>
            <p>Bạn có chắc chắn đã nhận được hàng?</p>
            <div class="order-modal-actions">
                <button class="app-button app-button-secondary" @onclick="CloseReceipt">Chưa</button>
                <button class="app-button app-button-primary" disabled="@isConfirming" @onclick="ConfirmReceiptAsync">Đã nhận được hàng</button>
            </div>
        </div>
    </div>
}

@code {

    [Parameter]
    public long Id { get; set; }

    private Order? order;

    private bool isLoading;

    private bool isCancelling;

    private bool isConfirming;

    private bool showReceipt;

    private string? errorMessage;

    private List<ReviewResponse> reviews = new();

    private long? editingItemId;

    private int draftRating = 5;

    private string draftContent = "";

    private bool isSavingReview;

    protected override async Task OnInitializedAsync()
    {
        await LoadOrderAsync();
    }

    private async Task LoadOrderAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            order =
                await OrderService.GetOrderByIdAsync(Id);

            if (order != null &&
                string.Equals(order.Status, "delivered", StringComparison.OrdinalIgnoreCase))
            {
                var mine = await ReviewService.GetMyReviewsAsync(page: 1, pageSize: 100);
                reviews = mine?.Items ?? new();
            }

            if (order == null)
            {
                errorMessage =
                    "Không thể tìm thấy đơn hàng.";
            }
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Có lỗi xảy ra: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CancelOrderAsync()
    {
        if (order == null || isCancelling)
        {
            return;
        }

        isCancelling = true;

        try
        {
            var success =
                await OrderService.CancelOrderAsync(order.Id);

            if (success)
            {
                await LoadOrderAsync();
            }
            else
            {
                errorMessage =
                    "Không thể hủy đơn hàng.";
            }
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Không thể hủy đơn hàng: {ex.Message}";
        }
        finally
        {
            isCancelling = false;
        }
    }

    private void OpenReceipt() => showReceipt = true;

    private void CloseReceipt() => showReceipt = false;

    private async Task ConfirmReceiptAsync()
    {
        if (order == null || isConfirming)
        {
            return;
        }

        isConfirming = true;
        try
        {
            var updated = await OrderService.ConfirmReceivedAsync(order.Id);
            showReceipt = false;
            order = updated ?? order;
            if (updated == null)
            {
                await LoadOrderAsync();
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            showReceipt = false;
        }
        finally
        {
            isConfirming = false;
        }
    }

    private ReviewResponse? FindReview(long orderItemId) =>
        reviews.FirstOrDefault(review => review.OrderItemId == orderItemId);

    private void BeginNew(long orderItemId)
    {
        editingItemId = orderItemId;
        draftRating = 5;
        draftContent = "";
    }

    private void BeginEdit(ReviewResponse review)
    {
        editingItemId = review.OrderItemId;
        draftRating = review.Rating;
        draftContent = review.Content ?? "";
    }

    private async Task SaveReview(OrderItem item)
    {
        if (order == null || isSavingReview)
        {
            return;
        }

        isSavingReview = true;
        errorMessage = null;
        var content = string.IsNullOrWhiteSpace(draftContent) ? null : draftContent.Trim();
        var existing = FindReview(item.Id);
        var ok = existing == null
            ? await ReviewService.CreateReviewAsync(new CreateReviewRequest
            {
                OrderId = order.Id,
                OrderItemId = item.Id,
                ProductId = item.ProductId,
                Rating = draftRating,
                Content = content
            })
            : await ReviewService.UpdateReviewAsync(existing.Id, new UpdateReviewRequest
            {
                Rating = draftRating,
                Content = content
            });
        isSavingReview = false;
        if (!ok)
        {
            errorMessage = "Không lưu được đánh giá.";
            return;
        }

        editingItemId = null;
        await LoadOrderAsync();
    }

    private static string Stars(int value) =>
        new string('★', Math.Clamp(value, 0, 5)) + new string('☆', Math.Max(0, 5 - value));

    private void GoBack()
    {
        Navigation.NavigateTo("/orders");
    }

    private void GoToOrders()
    {
        Navigation.NavigateTo("/orders");
    }

    private void GoToProducts()
    {
        Navigation.NavigateTo("/products");
    }

    private static bool CanConfirmReceipt(string? status)
    {
        return string.Equals(
            status,
            "awaiting_receipt",
            StringComparison.OrdinalIgnoreCase);
    }

    private static bool CanCancel(string? status)
    {
        return string.Equals(
                   status,
                   "pending",
                   StringComparison.OrdinalIgnoreCase)
               ||
               string.Equals(
                   status,
                   "awaiting_payment",
                   StringComparison.OrdinalIgnoreCase);
    }

    private static string GetStatusText(string? status)
    {
        return status?.ToLowerInvariant() switch
        {
            "pending" or "paid" => "Chờ shop xác nhận",
            "awaiting_payment" => "Chờ thanh toán",
            "confirmed" or "processing" => "Đã xác nhận",
            "shipping" or "shipped" => "Đang giao",
            "awaiting_receipt" => "Chờ xác nhận nhận hàng",
            "delivered" => "Đã giao thành công",
            "completed" => "Hoàn thành",
            "cancelled" => "Đã hủy",
            _ => status ?? "Không xác định"
        };
    }

    private static string GetStatusClass(string? status)
    {
        return status?.ToLowerInvariant() switch
        {
            "pending" => "status-pending",
            "confirmed" => "status-confirmed",
            "awaiting_payment" or "paid" => "status-pending",
            "processing" => "status-processing",
            "shipping" or "shipped" or "awaiting_receipt" => "status-shipped",
            "delivered" => "status-delivered",
            "completed" => "status-completed",
            "cancelled" => "status-cancelled",
            _ => "status-default"
        };
    }

    private static string GetPaymentMethodText(
        string? paymentMethod)
    {
        return paymentMethod?.ToLowerInvariant() switch
        {
            "cod" => "Thanh toán khi nhận hàng",
            "banking" => "Chuyển khoản",
            "vnpay" => "VNPay",
            "momo" => "MoMo",
            _ => paymentMethod ?? "Không xác định"
        };
    }

    private static string FormatMoney(decimal value)
    {
        return $"{value:N0} ₫";
    }
}