@page "/login"

@using Microsoft.JSInterop
@using MiniLogistics.Web.Models.Auth
@using MiniLogistics.Web.Services

@implements IDisposable

@inject AuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Login</PageTitle>

<div class="login-container">

    <div class="login-card">

        <h2>Đăng nhập</h2>

        <!-- ================================================= -->
        <!-- LOGIN EMAIL / PASSWORD -->
        <!-- ================================================= -->

        <EditForm Model="@loginRequest"
                  OnValidSubmit="HandleLogin">

            <DataAnnotationsValidator />

            <div class="form-group">

                <label>Email</label>

                <InputText class="form-control"
                           @bind-Value="loginRequest.Email" />

            </div>

            <div class="form-group">

                <label>Mật khẩu</label>

                <InputText type="password"
                           class="form-control"
                           @bind-Value="loginRequest.Password" />

            </div>


            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger">
                    @errorMessage
                </div>
            }


            <button type="submit"
                    class="btn btn-primary w-100"
                    disabled="@isLoading">

                @(isLoading
                    ? "Đang đăng nhập..."
                    : "Đăng nhập")

            </button>

        </EditForm>


        <!-- ================================================= -->
        <!-- DIVIDER -->
        <!-- ================================================= -->

        <div class="text-center my-3">

            <span>Hoặc</span>

        </div>


        <!-- ================================================= -->
        <!-- GOOGLE LOGIN -->
        <!-- ================================================= -->

        <div class="d-flex justify-content-center">

            <div id="google-login-button"></div>

        </div>


        @if (!string.IsNullOrEmpty(googleErrorMessage))
        {
            <div class="alert alert-danger mt-3">
                @googleErrorMessage
            </div>
        }

    </div>

</div>


@code {

    // =====================================================
    // EMAIL / PASSWORD
    // =====================================================

    private LoginRequest loginRequest = new();

    private string errorMessage = string.Empty;


    // =====================================================
    // GOOGLE
    // =====================================================

    private string googleErrorMessage = string.Empty;


    // =====================================================
    // LOADING
    // =====================================================

    private bool isLoading;


    // =====================================================
    // DOTNET REFERENCE
    // =====================================================

    private DotNetObjectReference<Login>? dotNetRef;


    // =====================================================
    // GOOGLE CLIENT ID
    // =====================================================
    //
    // THAY GIÁ TRỊ BÊN DƯỚI BẰNG CLIENT ID
    // MÀ BẠN VỪA TẠO TRÊN GOOGLE CLOUD
    //
    // Ví dụ:
    //
    // 123456789012-xxxxxxxxxxxxxxxx.apps.googleusercontent.com
    //
    // =====================================================

    private const string GoogleClientId =
        "446133726078-s3157ogtg63rsl1aqmords2581q8qcgl.apps.googleusercontent.com";


    // =====================================================
    // INITIALIZE GOOGLE
    // =====================================================

    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            dotNetRef =
                DotNetObjectReference.Create(this);

            await JS.InvokeVoidAsync(
                "googleAuth.initialize",
                GoogleClientId,
                dotNetRef);
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"GOOGLE INITIALIZE ERROR: {ex}");

            googleErrorMessage =
                "Không thể khởi tạo đăng nhập Google.";
        }
    }


    // =====================================================
    // GOOGLE CALLBACK
    // =====================================================
    //
    // Hàm này được google-auth.js gọi sau khi Google
    // đăng nhập thành công.
    //
    // response.credential
    //        ↓
    // idToken
    //        ↓
    // AuthService.GoogleLoginAsync()
    //        ↓
    // POST /api/auth/google
    //
    // =====================================================

    [JSInvokable]
    public async Task OnGoogleLogin(string idToken)
    {
        googleErrorMessage = string.Empty;

        isLoading = true;

        try
        {
            if (string.IsNullOrWhiteSpace(idToken))
            {
                googleErrorMessage =
                    "Google không trả về ID Token.";

                return;
            }


            Console.WriteLine(
                "Google ID Token đã nhận.");


            // =============================================
            // GỌI API BACKEND
            // =============================================

            var result =
                await AuthService.GoogleLoginAsync(idToken);


            // =============================================
            // API LOGIN THẤT BẠI
            // =============================================

            if (result == null)
            {
                googleErrorMessage =
                    "Đăng nhập Google thất bại.";

                return;
            }


            // =============================================
            // LOGIN THÀNH CÔNG
            // =============================================

            Console.WriteLine(
                $"Google Login thành công: {result.Email}");

            Console.WriteLine(
                $"UserId: {result.UserId}");

            Console.WriteLine(
                $"Role: {string.Join(", ", result.Roles)}");


            // =============================================
            // CUSTOMER
            // =============================================

            if (result.Roles.Contains(
                    "customer",
                    StringComparer.OrdinalIgnoreCase))
            {
                Navigation.NavigateTo("/customer");

                return;
            }


            // =============================================
            // CÁC ROLE KHÁC
            // =============================================

            Navigation.NavigateTo("/");
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"GOOGLE LOGIN ERROR: {ex}");

            googleErrorMessage =
                $"Đăng nhập Google thất bại: {ex.Message}";
        }
        finally
        {
            isLoading = false;

            StateHasChanged();
        }
    }


    // =====================================================
    // EMAIL / PASSWORD LOGIN
    // =====================================================

    private async Task HandleLogin()
    {
        errorMessage = string.Empty;

        isLoading = true;

        try
        {
            var result =
                await AuthService.LoginAsync(loginRequest);


            // =============================================
            // LOGIN THẤT BẠI
            // =============================================

            if (result == null)
            {
                errorMessage =
                    "Email hoặc mật khẩu không đúng.";

                return;
            }


            // =============================================
            // LOGIN THÀNH CÔNG
            // =============================================

            Console.WriteLine(
                $"Login thành công: {result.Email}");

            Console.WriteLine(
                $"Role: {string.Join(", ", result.Roles)}");


            // =============================================
            // CUSTOMER
            // =============================================

            if (result.Roles.Contains(
                    "customer",
                    StringComparer.OrdinalIgnoreCase))
            {
                Navigation.NavigateTo("/customer");

                return;
            }


            // =============================================
            // CÁC ROLE KHÁC
            // =============================================

            Navigation.NavigateTo("/");
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"LOGIN ERROR: {ex}");

            errorMessage =
                $"Không thể kết nối tới API: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }


    // =====================================================
    // DISPOSE
    // =====================================================

    public void Dispose()
    {
        dotNetRef?.Dispose();
    }
}