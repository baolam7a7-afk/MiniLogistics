@page "/seller/chat"
@page "/seller/chat/{ConversationId:long}"
@layout SellerLayout
@inject SellerApi Api
@inject SellerSession Session
@inject ChatLiveService Live
@inject NavigationManager Navigation
@inject IJSRuntime JS
@using System.Globalization
@using MiniLogistics.Web.Services.Chat
@implements IDisposable

<PageTitle>Chat với khách hàng</PageTitle>

<div class="chat-page">
<div class="seller-page-head">
    <div>
        <h1>Chat với khách hàng</h1>
        <p>Mỗi sản phẩm là một cuộc trò chuyện riêng. Shop không cần chọn lại.</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="app-alert app-alert-danger">@errorMessage</div>
}

<div class="seller-chat-layout">
    <aside class="seller-card seller-chat-list">
        @if (conversations.Count == 0)
        {
            <p class="seller-muted">Chưa có khách nhắn về sản phẩm.</p>
        }
        else
        {
            @foreach (var item in conversations.OrderByDescending(row => row.LastMessageAt ?? DateTime.MinValue))
            {
                <button type="button"
                        class="seller-chat-item @(ConversationId == item.Id ? "active" : null)"
                        @onclick="() => Open(item.Id)">
                    @if (!string.IsNullOrWhiteSpace(item.ProductImageUrl))
                    {
                        <img src="@item.ProductImageUrl" alt="" style="width:48px;height:48px;object-fit:cover;border-radius:8px" />
                    }
                    <span>
                        <strong>@(item.PeerName ?? "Khách hàng")</strong>
                        <span class="seller-muted" style="display:block">@(item.ProductName ?? "Sản phẩm")</span>
                        <span class="seller-muted" style="display:block">@(item.LastMessagePreview ?? "Chưa có tin")</span>
                    </span>
                    @if (item.UnreadCount > 0)
                    {
                        <span class="seller-chat-badge">@SellerText.CountBadge(item.UnreadCount)</span>
                    }
                </button>
            }
        }
    </aside>

    <section class="seller-card seller-chat-thread">
        @if (ConversationId is null or 0 || current == null)
        {
            <p class="seller-muted" style="padding:16px">Chọn một khách để trả lời.</p>
        }
        else
        {
            <div class="shop-chat-head">
                @if (!string.IsNullOrWhiteSpace(current.ShopLogoUrl))
                {
                    <img class="shop-chat-logo" src="@current.ShopLogoUrl" alt="@current.ShopName" />
                }
                <strong>@(current.ShopName ?? Session.Shop?.Name ?? "Shop")</strong>
                <span class="seller-muted">@ShopStatus(current.ShopStatus)</span>
                @if (!string.IsNullOrWhiteSpace(Live.LinkLabel))
                {
                    <div class="seller-muted">@Live.LinkLabel</div>
                }
            </div>
            <div class="shop-chat-product">
                @if (!string.IsNullOrWhiteSpace(current.ProductImageUrl))
                {
                    <img src="@current.ProductImageUrl" alt="@current.ProductName" />
                }
                <div>
                    <strong>@(current.ProductName ?? "Sản phẩm")</strong>
                    <span class="seller-muted">@Money(current.ProductPrice) · @Stock(current.ProductStock)</span>
                </div>
            </div>
            <div class="seller-chat-messages" @ref="messagePane" @onscroll="OnPaneScroll">
                @foreach (var message in messages)
                {
                    <div @key="message.Id" style="align-self:@(message.IsMine ? "flex-end" : "flex-start");max-width:75%">
                        @if (!string.IsNullOrWhiteSpace(message.SenderAvatarUrl))
                        {
                            <img src="@message.SenderAvatarUrl" alt="" style="width:24px;height:24px;border-radius:50%;object-fit:cover" />
                        }
                        <div style="background:@(message.IsMine ? "#0f766e" : "#f1f5f9");color:@(message.IsMine ? "#fff" : "#0f172a");padding:10px 12px;border-radius:14px">
                            @message.Content
                        </div>
                        <small class="seller-muted">@message.CreatedAt.ToLocalTime().ToString("HH:mm dd/MM")</small>
                    </div>
                }
            </div>
            @if (pendingNew > 0)
            {
                <button type="button" class="shop-chat-jump" @onclick="JumpToLatest">↓ @pendingNew tin nhắn mới</button>
            }
            <form class="seller-chat-compose" @onsubmit="Send" @onsubmit:preventDefault>
                <input class="seller-input" style="flex:1" @bind="draft" @bind:event="oninput" placeholder="Nhập tin nhắn..." />
                <button class="app-button app-button-primary" type="submit" disabled="@isSending">Gửi</button>
            </form>
        }
    </section>
</div>
</div>

@code {
    [Parameter] public long? ConversationId { get; set; }

    private List<SellerConversation> conversations = new();
    private List<SellerChatMessage> messages = new();
    private string draft = "";
    private string? errorMessage;
    private bool isSending;
    private Func<ChatInboxNotice, Task>? onInbox;
    private Func<Task>? onRestored;
    private Func<Task>? onLink;
    private readonly HashSet<long> seenMessages = new();
    private ElementReference messagePane;
    private bool scrollPending;
    private int pendingNew;

    private SellerConversation? current =>
        conversations.FirstOrDefault(item => item.Id == ConversationId);

    protected override async Task OnInitializedAsync()
    {
        onInbox = OnInboxAsync;
        onRestored = OnRestoredAsync;
        onLink = () => InvokeAsync(StateHasChanged);
        Live.InboxChanged += onInbox;
        Live.ConnectionRestored += onRestored;
        Live.LinkChanged += onLink;
        await Live.EnsureConnectedAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await Session.EnsureAsync();
        if (conversations.Count == 0)
        {
            await LoadConversations();
        }

        if (ConversationId is > 0)
        {
            await Live.JoinAsync(ConversationId.Value);
            await LoadMessages(ConversationId.Value);
        }
        else
        {
            messages = new();
        }
    }

    private async Task LoadConversations()
    {
        var result = await Api.GetAsync<List<SellerConversation>>("api/chat/conversations");
        if (!result.Ok || result.Data == null)
        {
            errorMessage = result.Error ?? "Không tải được tin nhắn.";
            conversations = new();
            return;
        }

        errorMessage = null;
        conversations = result.Data;
        await Session.RefreshChatUnreadAsync();
    }

    private async Task LoadMessages(long id)
    {
        var result = await Api.GetAsync<List<SellerChatMessage>>($"api/chat/conversations/{id}/messages");
        if (!result.Ok || result.Data == null)
        {
            errorMessage = result.Error ?? "Không tải được hội thoại.";
            return;
        }

        messages = result.Data
            .GroupBy(item => item.Id)
            .Select(group => group.First())
            .ToList();
        var row = conversations.FirstOrDefault(item => item.Id == id);
        if (row != null)
        {
            row.UnreadCount = 0;
        }

        pendingNew = 0;
        scrollPending = true;
        await Session.RefreshChatUnreadAsync();
    }

    private Task OnInboxAsync(ChatInboxNotice incoming)
    {
        return InvokeAsync(async () =>
        {
            if (incoming.MessageId > 0 &&
                (!seenMessages.Add(incoming.MessageId) ||
                 messages.Any(item => item.Id == incoming.MessageId)))
            {
                return;
            }

            if (incoming.MessageId <= 0)
            {
                var readRow = conversations.FirstOrDefault(item => item.Id == incoming.ConversationId);
                if (readRow != null)
                {
                    readRow.UnreadCount = 0;
                }

                await Session.RefreshChatUnreadAsync();
                StateHasChanged();
                return;
            }

            var open = ConversationId == incoming.ConversationId;
            var row = conversations.FirstOrDefault(item => item.Id == incoming.ConversationId);
            if (row == null)
            {
                await LoadConversations();
                row = conversations.FirstOrDefault(item => item.Id == incoming.ConversationId);
            }

            if (row != null)
            {
                row.LastMessagePreview = incoming.Content;
                row.LastMessageAt = incoming.CreatedAt;
                row.PeerName ??= incoming.SenderName;
                if (!string.IsNullOrWhiteSpace(incoming.ProductName))
                {
                    row.ProductName = incoming.ProductName;
                }

                if (!open)
                {
                    row.UnreadCount++;
                }
            }

            if (open)
            {
                messages.Add(new SellerChatMessage
                {
                    Id = incoming.MessageId,
                    Content = incoming.Content,
                    SenderName = incoming.SenderName,
                    SenderAvatarUrl = incoming.SenderAvatarUrl,
                    CreatedAt = incoming.CreatedAt,
                    IsRead = false,
                    IsMine = false
                });
                await TrackScrollAsync();
                await Api.PostAsync<object>($"api/chat/conversations/{incoming.ConversationId}/read", new { });
                if (row != null)
                {
                    row.UnreadCount = 0;
                }

                await Session.RefreshChatUnreadAsync();
            }

            StateHasChanged();
        });
    }

    private async Task OnRestoredAsync()
    {
        await LoadConversations();
        if (ConversationId is > 0)
        {
            await Live.JoinAsync(ConversationId.Value);
            await LoadMessages(ConversationId.Value);
        }
    }

    private async Task TrackScrollAsync()
    {
        var near = true;
        try
        {
            near = await JS.InvokeAsync<bool>("miniLogistics.isNearBottom", messagePane);
        }
        catch
        {
            near = true;
        }

        if (near)
        {
            pendingNew = 0;
            scrollPending = true;
        }
        else
        {
            pendingNew++;
        }
    }

    private async Task OnPaneScroll()
    {
        try
        {
            if (await JS.InvokeAsync<bool>("miniLogistics.isNearBottom", messagePane))
            {
                pendingNew = 0;
            }
        }
        catch
        {
            pendingNew = 0;
        }
    }

    private async Task JumpToLatest()
    {
        pendingNew = 0;
        scrollPending = true;
        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!scrollPending)
        {
            return;
        }

        scrollPending = false;
        try
        {
            await JS.InvokeVoidAsync("miniLogistics.scrollToEnd", messagePane);
        }
        catch
        {
            // Khung chat vẫn đã có tin mới nếu trình duyệt chưa kịp cuộn.
        }
    }

    private async Task Open(long id)
    {
        if (ConversationId == id)
        {
            await LoadMessages(id);
            await InvokeAsync(StateHasChanged);
            return;
        }

        Navigation.NavigateTo($"/seller/chat/{id}");
    }

    public void Dispose()
    {
        if (onInbox != null)
        {
            Live.InboxChanged -= onInbox;
        }

        if (onRestored != null)
        {
            Live.ConnectionRestored -= onRestored;
        }

        if (onLink != null)
        {
            Live.LinkChanged -= onLink;
        }
    }

    private async Task Send()
    {
        if (ConversationId is null or 0 || string.IsNullOrWhiteSpace(draft))
        {
            return;
        }

        isSending = true;
        var result = await Api.PostAsync<SellerChatMessage>(
            $"api/chat/conversations/{ConversationId}/messages",
            new { content = draft.Trim() });
        isSending = false;
        if (!result.Ok || result.Data == null)
        {
            errorMessage = result.Error ?? "Gửi tin nhắn thất bại.";
            return;
        }

        draft = "";
        seenMessages.Add(result.Data.Id);
        if (messages.All(item => item.Id != result.Data.Id))
        {
            messages.Add(result.Data);
        }

        var row = conversations.FirstOrDefault(item => item.Id == ConversationId);
        if (row != null)
        {
            row.LastMessagePreview = result.Data.Content;
            row.LastMessageAt = result.Data.CreatedAt;
        }

        pendingNew = 0;
        scrollPending = true;
    }

    private static string ShopStatus(string? status) => status switch
    {
        "approved" => "Đang hoạt động",
        "pending" => "Chờ duyệt",
        "rejected" => "Tạm ngưng",
        "suspended" => "Tạm ngưng",
        null or "" => "Shop",
        _ => status
    };

    private static string Money(decimal? price) =>
        price is null ? "" : price.Value.ToString("N0", CultureInfo.GetCultureInfo("vi-VN")) + "đ";

    private static string Stock(int? stock) =>
        stock is > 0 ? "Còn hàng" : "Hết hàng";
}
