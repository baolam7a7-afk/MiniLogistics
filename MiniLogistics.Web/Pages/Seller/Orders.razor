@page "/seller/orders"
@layout SellerLayout
@inject SellerApi Api
@inject SellerSession Session

<PageTitle>Đơn hàng Seller</PageTitle>

<div class="seller-page-head">
    <div>
        <h1>Đơn hàng</h1>
        <p>Đơn thuộc các cửa hàng của seller. API lọc theo từ khóa và trạng thái.</p>
    </div>
</div>

<div class="seller-filters">
    <input class="seller-input" placeholder="Mã đơn" @bind="search" />
    <select class="seller-select" @bind="status">
        <option value="">Mọi trạng thái</option>
        <option value="pending">Chờ shop xác nhận</option>
        <option value="confirmed">Đã xác nhận</option>
        <option value="shipping">Đang giao</option>
        <option value="awaiting_receipt">Chờ khách xác nhận</option>
        <option value="delivered">Đã giao thành công</option>
        <option value="cancelled">Đã hủy</option>
        <option value="awaiting_payment">Chờ thanh toán</option>
        <option value="paid">Đã thanh toán</option>
    </select>
    <input class="seller-input" type="date" @bind="fromDate" />
    <input class="seller-input" type="date" @bind="toDate" />
    <button class="app-button app-button-secondary" @onclick="Search">Lọc</button>
</div>
<p class="seller-muted">Lọc theo ngày áp dụng trên trang đang xem vì API đơn hàng không nhận khoảng ngày.</p>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="app-alert app-alert-danger">@errorMessage</div>
}

@if (isLoading)
{
    <div class="seller-loading">Đang tải đơn hàng...</div>
}
else if (!visible.Any())
{
    <div class="seller-empty">Không có đơn hàng phù hợp.</div>
}
else
{
    <div class="seller-card">
        <div class="seller-table-wrap">
            <table class="seller-table">
                <thead>
                    <tr>
                        <th>Mã</th>
                        <th>Khách</th>
                        <th>Điện thoại</th>
                        <th>Shop</th>
                        <th>Tổng</th>
                        <th>Trạng thái</th>
                        <th>Tạo lúc</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in visible)
                    {
                        <tr>
                            <td><a href="@($"/seller/orders/{order.Id}")">@order.OrderCode</a></td>
                            <td>@(order.CustomerName ?? $"#{order.CustomerId}")</td>
                            <td>@(order.CustomerPhone ?? "—")</td>
                            <td>@(order.ShopName ?? $"#{order.ShopId}")</td>
                            <td>@SellerText.Money(order.Total)</td>
                            <td><span class="seller-badge">@SellerText.OrderStatus(order.Status)</span></td>
                            <td>@SellerText.When(order.PlacedAt)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="seller-pager">
            <button class="app-button app-button-secondary" disabled="@(pageIndex <= 1)" @onclick="PreviousPage">Trước</button>
            <span>Trang @pageIndex / @Math.Max(totalPages, 1)</span>
            <button class="app-button app-button-secondary" disabled="@(pageIndex >= totalPages)" @onclick="NextPage">Sau</button>
        </div>
    </div>
}

@code {
    private List<SellerOrder> items = new();
    private string search = "";
    private string status = "";
    private DateTime? fromDate;
    private DateTime? toDate;
    private int pageIndex = 1;
    private int totalPages = 1;
    private bool isLoading = true;
    private string? errorMessage;

    private IEnumerable<SellerOrder> visible => items.Where(order =>
    {
        var day = order.PlacedAt.Kind == DateTimeKind.Utc
            ? order.PlacedAt.ToLocalTime().Date
            : order.PlacedAt.Date;
        if (IsChosenDate(fromDate) && day < fromDate!.Value.Date)
        {
            return false;
        }
        if (IsChosenDate(toDate) && day > toDate!.Value.Date)
        {
            return false;
        }
        return true;
    });

    private static bool IsChosenDate(DateTime? value) =>
        value.HasValue && value.Value.Year >= 2000;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureAsync();
        await LoadAsync();
    }

    private async Task Search()
    {
        pageIndex = 1;
        await LoadAsync();
    }

    private Task PreviousPage() => Go(pageIndex - 1);

    private Task NextPage() => Go(pageIndex + 1);

    private async Task Go(int next)
    {
        pageIndex = next;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        var query = $"api/orders/shop?Page={pageIndex}&PageSize=10";
        if (!string.IsNullOrWhiteSpace(search))
        {
            query += $"&Search={Uri.EscapeDataString(search)}";
        }
        if (!string.IsNullOrWhiteSpace(status))
        {
            query += $"&Status={Uri.EscapeDataString(status)}";
        }

        var result = await Api.GetAsync<PagedResult<SellerOrder>>(query);
        isLoading = false;
        if (!result.Ok || result.Data == null)
        {
            errorMessage = result.Error;
            items = new();
            return;
        }

        errorMessage = null;
        items = result.Data.Items;
        totalPages = result.Data.TotalPages;
    }
}
