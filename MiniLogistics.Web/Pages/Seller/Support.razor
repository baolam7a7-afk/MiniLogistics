@page "/seller/support"
@layout SellerLayout
@inject SellerApi Api
@inject SellerSession Session

<PageTitle>Hỗ trợ</PageTitle>

<div class="seller-page-head">
    <div>
        <h1>Hỗ trợ</h1>
        <p>API chỉ trả ticket do chính tài khoản này tạo, không có danh sách ticket của khách theo cửa hàng.</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="app-alert @(isError ? "app-alert-danger" : "app-alert-success")">@message</div>
}

<section class="seller-card">
    <h2>Tạo ticket</h2>
    <div class="seller-actions">
        <input class="seller-input" placeholder="Tiêu đề" @bind="subject" />
        <button class="app-button app-button-primary" @onclick="Create">Tạo</button>
    </div>
</section>

@if (isLoading)
{
    <div class="seller-loading">Đang tải ticket...</div>
}
else if (tickets.Count == 0)
{
    <div class="seller-empty">Chưa có ticket.</div>
}
else
{
    <section class="seller-card">
        <div class="seller-table-wrap">
            <table class="seller-table">
                <thead>
                    <tr>
                        <th>Tiêu đề</th>
                        <th>Trạng thái</th>
                        <th>Đơn</th>
                        <th>Tạo lúc</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ticket in tickets)
                    {
                        <tr>
                            <td>@ticket.Subject</td>
                            <td>@SellerText.TicketStatus(ticket.Status)</td>
                            <td>@(ticket.OrderId?.ToString() ?? "—")</td>
                            <td>@SellerText.When(ticket.CreatedAt)</td>
                            <td><button class="app-button app-button-secondary" @onclick="() => Open(ticket)">Xem</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}

@if (opened != null)
{
    <section class="seller-card">
        <h2>@opened.Subject</h2>
        <label class="seller-field">Trạng thái
            <select class="seller-select" @bind="openedStatus">
                <option value="open">Mở</option>
                <option value="in_progress">Đang xử lý</option>
                <option value="resolved">Đã xử lý</option>
                <option value="closed">Đã đóng</option>
            </select>
        </label>
        <button class="app-button app-button-secondary" @onclick="UpdateStatus">Lưu trạng thái</button>
        @foreach (var item in messages)
        {
            <p><strong>#@item.SenderUserId:</strong> @item.Message <span class="seller-muted">@SellerText.When(item.CreatedAt)</span></p>
        }
        <div class="seller-actions">
            <input class="seller-input" @bind="reply" placeholder="Nội dung" />
            <button class="app-button app-button-primary" @onclick="Send">Gửi</button>
        </div>
    </section>
}

@code {
    private List<SupportTicketRecord> tickets = new();
    private List<SupportMessageRecord> messages = new();
    private SupportTicketRecord? opened;
    private string subject = "";
    private string openedStatus = "open";
    private string reply = "";
    private bool isLoading = true;
    private bool isError;
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureAsync();
        if (Session.Forbidden)
        {
            isLoading = false;
            return;
        }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        var result = await Api.GetAsync<PagedResult<SupportTicketRecord>>(
            "api/support-tickets/my?Page=1&PageSize=50");
        isLoading = false;
        if (!result.Ok || result.Data == null)
        {
            isError = true;
            message = result.Error;
            tickets = new();
            return;
        }

        tickets = result.Data.Items;
    }

    private async Task Create()
    {
        if (string.IsNullOrWhiteSpace(subject))
        {
            isError = true;
            message = "Nhập tiêu đề ticket.";
            return;
        }

        var result = await Api.PostAsync<SupportTicketRecord>("api/support-tickets", new
        {
            Subject = subject.Trim()
        });
        isError = !result.Ok;
        message = result.Ok ? "Đã tạo ticket." : result.Error;
        if (result.Ok)
        {
            subject = "";
            await LoadAsync();
        }
    }

    private async Task Open(SupportTicketRecord ticket)
    {
        opened = ticket;
        openedStatus = ticket.Status;
        var result = await Api.GetAsync<PagedResult<SupportMessageRecord>>(
            $"api/support-messages/ticket/{ticket.Id}?Page=1&PageSize=50");
        messages = result.Data?.Items ?? new();
        if (!result.Ok)
        {
            isError = true;
            message = result.Error;
        }
    }

    private async Task UpdateStatus()
    {
        if (opened == null)
        {
            return;
        }

        var result = await Api.PutAsync<SupportTicketRecord>($"api/support-tickets/{opened.Id}", new
        {
            Subject = opened.Subject,
            Status = openedStatus
        });
        isError = !result.Ok;
        message = result.Ok ? "Đã cập nhật ticket." : result.Error;
        if (result.Ok && result.Data != null)
        {
            opened = result.Data;
            await LoadAsync();
        }
    }

    private async Task Send()
    {
        if (opened == null || string.IsNullOrWhiteSpace(reply))
        {
            return;
        }

        var result = await Api.PostAsync<SupportMessageRecord>("api/support-messages", new
        {
            TicketId = opened.Id,
            Message = reply.Trim()
        });
        isError = !result.Ok;
        message = result.Ok ? "Đã gửi tin nhắn." : result.Error;
        if (result.Ok)
        {
            reply = "";
            await Open(opened);
        }
    }
}
