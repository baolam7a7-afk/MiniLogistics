@page "/shipper/shipments"
@layout ShipperLayout
@using MiniLogistics.Web.Services.Seller
@inject SellerApi Api
@inject ShipperSession Session

<PageTitle>Đơn giao hàng</PageTitle>

<div class="shipper-head">
    <h1>Đơn giao</h1>
    <p>Chỉ các shipment đã gán cho bạn. Tìm theo mã vận đơn hoặc mã đơn số.</p>
</div>

<div class="shipper-filters">
    <input class="shipper-input" placeholder="Mã vận đơn hoặc mã đơn" @bind="search" />
    <select class="shipper-select" @bind="status">
        <option value="">Mọi trạng thái</option>
        <option value="assigned">Chờ lấy hàng</option>
        <option value="picked_up">Đã lấy hàng</option>
        <option value="shipping">Đang giao</option>
        <option value="delivered">Đã giao</option>
    </select>
    <button class="app-button app-button-primary" @onclick="Search">Lọc</button>
</div>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="app-alert app-alert-danger">@errorMessage</div>
}

@if (isLoading)
{
    <p class="shipper-muted">Đang tải danh sách...</p>
}
else if (items.Count == 0)
{
    <div class="shipper-card">
        <p>Chưa có đơn phù hợp. Đơn xuất hiện sau khi admin hoặc seller gán cho bạn.</p>
    </div>
}
else
{
    @foreach (var item in items)
    {
        <a class="shipper-card shipper-job" href="@($"/shipper/shipments/{item.Id}")">
            <div class="shipper-row">
                <strong>@(string.IsNullOrWhiteSpace(item.TrackingCode) ? $"Shipment #{item.Id}" : item.TrackingCode)</strong>
                <span class="shipper-badge @ShipperText.Badge(item.Status)">@ShipperText.Status(item.Status)</span>
            </div>
            <span>Đơn #@item.OrderId</span>
            <span class="shipper-muted">COD @SellerText.Money(item.CodAmount)</span>
            <span class="shipper-muted">@SellerText.When(item.AssignedAt ?? item.CreatedAt)</span>
        </a>
    }

    <div class="shipper-pager">
        <button class="app-button app-button-secondary" disabled="@(pageIndex <= 1 || isLoading)" @onclick="Previous">Trước</button>
        <span>Trang @pageIndex / @Math.Max(totalPages, 1)</span>
        <button class="app-button app-button-secondary" disabled="@(pageIndex >= totalPages || isLoading)" @onclick="Next">Sau</button>
    </div>
}

@code {
    private List<ShipmentRecord> items = new();
    private string search = "";
    private string status = "";
    private int pageIndex = 1;
    private int totalPages = 1;
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureAsync();
        await LoadAsync();
    }

    private async Task Search()
    {
        pageIndex = 1;
        await LoadAsync();
    }

    private Task Previous() => Go(pageIndex - 1);

    private Task Next() => Go(pageIndex + 1);

    private async Task Go(int page)
    {
        pageIndex = page;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (Session.Forbidden || Session.Profile == null)
        {
            isLoading = false;
            return;
        }

        isLoading = true;
        var query = new List<string>
        {
            $"Page={pageIndex}",
            "PageSize=10"
        };
        if (!string.IsNullOrWhiteSpace(status))
        {
            query.Add($"Status={Uri.EscapeDataString(status)}");
        }

        var term = search.Trim();
        if (long.TryParse(term, out var orderId))
        {
            query.Add($"OrderId={orderId}");
        }
        else if (!string.IsNullOrWhiteSpace(term))
        {
            query.Add($"Search={Uri.EscapeDataString(term)}");
        }

        var result = await Api.GetAsync<PagedResult<ShipmentRecord>>(
            "api/shipments/my?" + string.Join("&", query));
        isLoading = false;
        if (result.StatusCode == 401)
        {
            return;
        }

        if (!result.Ok || result.Data == null)
        {
            errorMessage = result.Error ?? "Không tải được danh sách giao hàng.";
            items = new();
            return;
        }

        errorMessage = null;
        items = result.Data.Items;
        totalPages = result.Data.TotalPages;
    }
}
